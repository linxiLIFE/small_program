{
  "envId": "cloud1-d9g5pfect2ece00fa",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "api",
      "timeout": 20,
      "memorySize": 256,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "description": "四个小姐姐的店预约小程序业务 API",
      "vpc": {
        "vpcId": "vpc-92zwp758",
        "subnetId": "subnet-6sf7e7m9"
      }
    },
    {
      "name": "jobs",
      "timeout": 60,
      "memorySize": 256,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "description": "四个小姐姐的店预约、支付和退款补偿任务",
      "triggers": [
        {
          "name": "shiguang-jobs-every-minute",
          "type": "timer",
          "config": "0 */1 * * * * *"
        }
      ],
      "vpc": {
        "vpcId": "vpc-92zwp758",
        "subnetId": "subnet-6sf7e7m9"
      }
    },
    {
      "name": "admin-api",
      "timeout": 20,
      "memorySize": 256,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "description": "四个小姐姐的店管理后台 HTTPS API",
      "vpc": {
        "vpcId": "vpc-92zwp758",
        "subnetId": "subnet-6sf7e7m9"
      }
    },
    {
      "name": "payment-callback",
      "type": "HTTP",
      "gatewayPath": "/payment-callback",
      "timeout": 20,
      "memorySize": 256,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "description": "四个小姐姐的店微信支付 API v3 回调入口",
      "vpc": {
        "vpcId": "vpc-92zwp758",
        "subnetId": "subnet-6sf7e7m9"
      }
    }
  ],
  "ai": {
    "defaultAgent": "{{env.AI_DEFAULT_AGENT}}",
    "agents": {
      "codex": {
        "type": "cloudbase",
        "provider": "longcat",
        "model": "LongCat-Flash-Chat"
      }
    }
  }
}
