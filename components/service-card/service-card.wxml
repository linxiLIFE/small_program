<view class="service-card {{compact ? 'compact' : ''}} {{selected ? 'selected' : ''}}" bindtap="handleTap">
  <view class="cover-wrap">
    <image wx:if="{{service.coverUrl && !imageError}}" class="cover" mode="aspectFill" src="{{service.coverUrl}}" binderror="handleImageError" />
    <view wx:else class="cover-fallback">
      <text class="fallback-mark">✦</text>
      <text>{{service.categoryName || '拾光美研'}}</text>
    </view>
    <text class="category-pill">{{service.categoryName}}</text>
  </view>
  <view class="service-body">
    <view class="service-title-row">
      <text class="service-name">{{service.name}}</text>
      <text class="arrow">›</text>
    </view>
    <text class="service-description">{{service.description}}</text>
    <view class="service-meta">
      <text class="price">¥{{service.priceText}}</text>
      <view class="service-meta-copy"><text class="duration">{{service.durationText}}</text><text class="style-count">{{service.styleCount || 0}} 款式</text></view>
    </view>
  </view>
</view>
