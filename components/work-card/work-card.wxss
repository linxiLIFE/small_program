.work-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(104, 69, 63, 0.08);
}

.work-card.selected {
  box-shadow: 0 0 0 3rpx #bb6f79, 0 10rpx 28rpx rgba(104, 69, 63, 0.12);
}

.work-image-wrap {
  position: relative;
  height: 320rpx;
}

.work-image,
.work-placeholder {
  width: 100%;
  height: 100%;
}

.work-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 12rpx;
  background: linear-gradient(150deg, #edd4d0 0%, #f3e4dd 48%, #dfc3c4 100%);
  color: #9d6870;
  font-size: 24rpx;
}

.work-placeholder text:first-child {
  font-family: inherit;
  font-size: 56rpx;
}

.work-category {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 251, 0.88);
  color: #9f626b;
  font-size: 21rpx;
}

.work-content {
  padding: 20rpx 22rpx 24rpx;
}

.work-title,
.work-description {
  display: block;
}

.work-title {
  color: #332c2b;
  font-size: 28rpx;
  font-weight: 700;
}

.work-description {
  display: -webkit-box;
  height: 42rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: #9a8581;
  font-size: 23rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.work-popularity{display:block;margin-top:12rpx;font-size:22rpx;color:#aa737b;font-weight:400}
.work-service{display:block;margin-top:9rpx;overflow:hidden;color:#9f8982;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}
