<view class="work-card {{selected ? 'selected' : ''}}" bindtap="handleTap">
  <view class="work-image-wrap">
    <image wx:if="{{work.imageUrl && !imageError}}" class="work-image" mode="aspectFill" lazy-load="{{true}}" webp="{{true}}" src="{{work.imageUrl}}" binderror="handleImageError" />
    <view wx:else class="work-placeholder"><text>拾光</text><text>{{work.categoryName}}</text></view>

  </view>
  <view class="work-content">
    <text class="work-title">{{work.title}}</text><text wx:if="{{work.serviceName}}" class="work-service">{{work.serviceName}}</text><text class="work-popularity">♡ {{work.bookingCount || 0}} 次预约</text>

  </view>
</view>
