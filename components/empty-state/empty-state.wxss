.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 360rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f7e6e3;
  color: #c18a8b;
  font-family: inherit;
  font-size: 44rpx;
}

.empty-icon-shape {
  position: relative;
  width: 32rpx;
  height: 38rpx;
  border: 4rpx solid #c18a8b;
  border-radius: 8rpx 8rpx 12rpx 12rpx;
}

.empty-icon-shape::before {
  position: absolute;
  top: 10rpx;
  left: 7rpx;
  width: 10rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #c18a8b;
  content: '';
}

.empty-icon-shape::after {
  position: absolute;
  bottom: -10rpx;
  left: 8rpx;
  width: 8rpx;
  height: 8rpx;
  border: 4rpx solid #c18a8b;
  border-radius: 50%;
  background: #f7e6e3;
  content: '';
}

.empty-title {
  margin-top: 24rpx;
  color: #594846;
  font-size: 29rpx;
  font-weight: 600;
}

.empty-description {
  max-width: 560rpx;
  margin-top: 12rpx;
  color: #a6918d;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-button {
  height: 72rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #bb6f79;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}
