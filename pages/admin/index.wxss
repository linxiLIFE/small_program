page{background:#fffaf7;color:#594846;font-size:27rpx}
.admin-native{min-height:100vh;padding:0 28rpx calc(180rpx + env(safe-area-inset-bottom))}
.admin-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:92rpx;border-bottom:1rpx solid #f0e4df;margin-bottom:34rpx}
.admin-toolbar>text{flex:1;overflow:hidden;text-align:right;text-overflow:ellipsis;white-space:nowrap;color:#9a8581;font-size:24rpx}
.back-button{flex:none;padding:0;margin:0;border:0;background:transparent;color:#a7616d;font-size:26rpx;line-height:80rpx}
.page-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:0 0 28rpx}
.page-heading>view{min-width:0}.page-title{display:block;color:#4c3d3a;font-size:42rpx;font-weight:650;line-height:1.4}
.panel{margin:22rpx 0;padding:28rpx;border:1rpx solid #eedfd9;border-radius:26rpx;background:#fffdfb;box-shadow:0 10rpx 26rpx #68453f08}
.card-title{display:block;font-size:29rpx;line-height:1.5;font-weight:600}.copy{display:block;font-size:25rpx;line-height:1.7;margin-top:10rpx}.muted{display:block;color:#9d8781;font-size:23rpx;line-height:1.7}
.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-width:0;margin:12rpx 0}.row>picker{flex:1;min-width:0}.row>label{display:flex;align-items:center;gap:10rpx;color:#9a8581;font-size:24rpx}
.actions{display:flex;justify-content:flex-end;align-items:center;gap:18rpx;flex-wrap:wrap;margin-top:24rpx}.actions>text{margin-right:auto;font-size:24rpx;color:#9a8581}
.admin-native button,.modal button,.crop-dialog button{width:auto;margin-left:0;margin-right:0;flex-shrink:0}
.primary-button{min-height:78rpx;padding:0 28rpx;margin:26rpx 0 0;border:0;border-radius:17rpx;background:#b96d78;color:#fff;font-size:26rpx;line-height:78rpx}
.soft-button{min-height:66rpx;padding:0 22rpx;border:1rpx solid #ead7d2;border-radius:15rpx;background:#fff8f4;color:#895e62;font-size:24rpx;line-height:64rpx}
.text-button{height:auto;min-height:54rpx;margin:0;padding:0 6rpx;border:0;background:transparent;color:#a96874;font-size:24rpx;line-height:54rpx}
.actions .primary-button{margin-top:0}.page-heading .soft-button{margin:0}.admin-native button[disabled],.modal button[disabled]{opacity:.5}
input,textarea,.select-input,.time-input{min-width:0;border:1rpx solid #eadbd6;border-radius:14rpx;background:#fffcfa;color:#594846;font-size:26rpx;box-sizing:border-box}
input{height:78rpx;padding:0 18rpx;width:100%}textarea{width:100%;height:160rpx;padding:16rpx;line-height:1.6}
.field{display:block;margin:24rpx 0}.field>text,.field-label{display:block;margin-bottom:12rpx;color:#9a8178;font-size:24rpx}
.select-input{display:block;min-height:76rpx;line-height:1.5;padding:18rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin:12rpx 0}
.time-input{padding:14rpx 12rpx;text-align:center;min-width:110rpx}.flex-input{flex:1;min-width:0}
.filter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.filter-grid .select-input{margin:0}.filters>input{margin-bottom:18rpx}
.login-panel{margin:70rpx 10rpx;padding:44rpx 34rpx}.brand-icon{display:flex;width:88rpx;height:88rpx;align-items:center;justify-content:center;margin-bottom:32rpx;border-radius:28rpx;background:#f4dedb;color:#b66d76;font-size:54rpx}.login-panel .primary-button{width:100%}
.empty{padding:70rpx 20rpx;text-align:center;font-size:27rpx;color:#a08c86}
.error-copy{display:block;color:#b2615d;font-size:25rpx;line-height:1.6}.success-copy{color:#648e6b;font-size:25rpx}.message{margin:18rpx 0;padding:20rpx 24rpx;border-radius:15rpx;background:#f8eeea}
.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;margin-top:22rpx}.metric{min-width:0;margin:0;min-height:186rpx;padding:26rpx 22rpx}.metric>text:first-child{display:block;color:#977f79;font-size:23rpx}.metric-value{display:block;overflow:hidden;margin-top:22rpx;color:#594846;font-size:37rpx;font-weight:650;text-overflow:ellipsis;white-space:nowrap}.metric.accent{background:linear-gradient(135deg,#b8757e,#9f626e);border-color:#b8757e}.metric.accent>text{color:#fffaf7}
.trend-scroll{width:100%;margin-top:26rpx}.trend{display:flex;gap:10rpx;align-items:flex-end;min-width:100%;height:250rpx}.trend-column{flex:0 0 34rpx;text-align:center}.trend-track{display:flex;align-items:flex-end;height:200rpx;background:#f8efeb;border-radius:7rpx;overflow:hidden}.trend-bar{width:100%;background:#bd8189;border-radius:7rpx}.trend-bar.negative{background:#b2a9a1}.trend-column>text{font-size:16rpx;color:#a68f88}.summary-row{font-size:23rpx;color:#967e77;margin-top:26rpx}.ranking{display:flex;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #f4eae6;font-size:25rpx}.ranking:last-child{border:0}.ranking>text:first-child{min-width:0;flex:1}
.badge{max-width:45%;padding:8rpx 15rpx;border-radius:20rpx;background:#f6e8e4;color:#a66a72;font-size:22rpx;white-space:nowrap}.amount{font-size:34rpx;font-weight:600;color:#a96874}.order-id{display:block;word-break:break-all;color:#b29d97;font-size:20rpx;margin-top:12rpx}.order-work,.media-row{display:flex;gap:22rpx;align-items:center;margin:12rpx 0}.order-work image,.media-row image{flex:none;width:126rpx;height:126rpx;border-radius:18rpx}.media-row>view{min-width:0;flex:1}.order-work>text{font-size:25rpx}.pagination{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:30rpx 0;font-size:24rpx}
.bottom-tabs{position:fixed;z-index:20;left:0;right:0;bottom:0;display:flex;padding:12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom));border-top:1rpx solid #efdfd9;background:#fffdfb;box-shadow:0 -8rpx 28rpx #68453f08}.bottom-tab{display:flex;flex:1;align-items:center;justify-content:center;flex-direction:column;gap:6rpx;min-height:98rpx;border-radius:22rpx;color:#9a8581}.bottom-tab>text:first-child{font-size:42rpx;line-height:1.1}.bottom-tab>text:last-child{font-size:23rpx}.bottom-tab.active{color:#b96d78;background:#fcf0ed;font-weight:600}
.menu{padding:0 26rpx}.menu-row{display:flex;align-items:center;gap:24rpx;min-height:130rpx;border-bottom:1rpx solid #f2e6e0}.menu-row:last-child{border:0}.menu-row>text:nth-child(2){flex:1}.menu-row>text:last-child{font-size:36rpx;color:#b39d98}.menu-icon{display:flex;width:66rpx;height:66rpx;align-items:center;justify-content:center;border-radius:20rpx;background:#f8e9e5;color:#b8757e;font-size:36rpx}
.segment{display:flex;gap:12rpx;margin-bottom:22rpx}.segment button{flex:1;padding:0;border:0;border-radius:16rpx;background:#f5eae5;color:#9a8581;font-size:25rpx;line-height:72rpx}.segment .selected{background:#bb6f79;color:#fff}
.banner-preview{display:block;width:100%;height:290rpx;border-radius:20rpx;margin-bottom:22rpx}.qr-preview{display:block;width:100%;height:340rpx;margin:20rpx 0}.weekly-day{padding:24rpx 0;border-bottom:1rpx solid #efdfd9}.shift-card{margin:18rpx 0;padding:18rpx;border-radius:16rpx;background:#faf2ed}.shift-card .row{gap:10rpx}.break-row{flex-wrap:wrap;font-size:23rpx}.break-row picker{flex:none}.break-row .time-input{min-width:96rpx}.personal-title{display:flex;gap:20rpx;align-items:center;margin:24rpx 0}.notification-block{padding-top:22rpx;margin-top:22rpx;border-top:1rpx solid #efdfd9}
.modal-mask{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end;justify-content:center;padding:50rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));background:#30201d80}.modal{width:100%;max-height:88vh;padding:32rpx;border-radius:30rpx;background:#fffaf7;box-sizing:border-box}.modal.scroll-view{overflow:auto}.modal .primary-button{width:100%}.editor-preview{display:block;width:100%;height:260rpx;margin:16rpx 0}.checkboxes{display:flex;flex-wrap:wrap;gap:20rpx}.checkboxes label{display:flex;align-items:center;font-size:25rpx}.checkboxes checkbox{transform:scale(.8)}
.crop-mask{z-index:150;align-items:center;padding:24px}.crop-dialog{width:100%;padding:28rpx 0;border-radius:22rpx;background:#fffaf7;text-align:center}.crop-stage{position:relative;overflow:hidden;margin:26rpx 0;background:#eaded7}.crop-stage image{position:absolute;max-width:none}.crop-dialog .actions,.crop-dialog .card-title,.crop-dialog .error-copy{margin-right:20rpx;margin-left:20rpx}.crop-canvas{position:fixed;left:-2000px;top:-2000px;width:1200px;height:600px}
scroll-view.modal{height:88vh}
