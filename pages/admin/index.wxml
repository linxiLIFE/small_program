<template name="orderCard">
  <view class="panel order-card">
    <view class="row"><text class="card-title">{{order.serviceName}}</text><text class="badge">{{order.statusLabel}}</text></view>
    <view wx:if="{{order.work}}" class="order-work"><image wx:if="{{order.work.imageUrl}}" src="{{order.work.imageUrl}}" mode="aspectFill"/><text>{{order.work.title}}</text></view>
    <text class="copy">{{order.customerName || '预约顾客'}} · {{order.technicianName}}</text>
    <text class="copy">{{order.timeLabel}}</text>
    <text wx:if="{{order.addonLabel}}" class="muted">{{order.addonLabel}}</text>
    <view class="row"><text class="amount">{{order.moneyLabel}}</text><button wx:if="{{order.phone}}" class="text-button" data-phone="{{order.phone}}" bindtap="callCustomer">{{order.phone}}</button></view>
    <text class="order-id" selectable>{{order.id}}</text>
    <text wx:if="{{order.refundInProgress}}" class="muted">退款处理中</text>
    <text wx:if="{{order.refundStatus === 'WAITING_FUNDS'}}" class="error-copy">商户余额不足，退款待重试</text>
    <view class="actions"><button wx:if="{{order.transition}}" class="soft-button" data-id="{{order.id}}" data-action="{{order.transition}}" disabled="{{saving}}" bindtap="transition">{{order.transitionLabel}}</button><button wx:if="{{order.canRefund}}" class="text-button" data-id="{{order.id}}" bindtap="openRefund">退款</button></view>
  </view>
</template>

<template name="shiftList">
  <view wx:for="{{shifts}}" wx:for-item="shift" wx:for-index="si" wx:key="start" class="shift-card">
    <view class="row"><picker mode="time" value="{{shift.start}}" data-path="{{base}}.shifts[{{si}}].start" bindchange="setField"><view class="time-input">{{shift.start}}</view></picker><text>至</text><picker mode="time" value="{{shift.end}}" data-path="{{base}}.shifts[{{si}}].end" bindchange="setField"><view class="time-input">{{shift.end}}</view></picker><button class="text-button" data-base="{{base}}" data-day="{{day}}" data-index="{{si}}" bindtap="removeShift">移除班次</button></view>
    <view wx:for="{{shift.breaks}}" wx:for-item="rest" wx:for-index="bi" wx:key="start" class="row break-row"><text>休息</text><picker mode="time" value="{{rest.start}}" data-path="{{base}}.shifts[{{si}}].breaks[{{bi}}].start" bindchange="setField"><view class="time-input">{{rest.start}}</view></picker><text>至</text><picker mode="time" value="{{rest.end}}" data-path="{{base}}.shifts[{{si}}].breaks[{{bi}}].end" bindchange="setField"><view class="time-input">{{rest.end}}</view></picker><button class="text-button" data-base="{{base}}" data-day="{{day}}" data-shift="{{si}}" data-index="{{bi}}" data-action="remove" bindtap="changeBreak">移除</button></view>
    <button class="text-button" data-base="{{base}}" data-day="{{day}}" data-shift="{{si}}" data-action="add" bindtap="changeBreak">＋ 添加休息时间</button>
  </view>
  <button class="soft-button" data-base="{{base}}" data-index="{{day}}" bindtap="addShift">＋ 添加班次</button>
</template>

<template name="dayPlan">
  <view wx:if="{{plan}}" class="panel">
    <view class="row"><text class="card-title">当天排班</text><label>休息 / 请假 <switch checked="{{plan.leave}}" data-path="plan.leave" bindchange="setField" color="#bb6f79"/></label></view>
    <text wx:if="{{plan.occupancyCount}}" class="muted">已有 {{plan.occupancyCount}} 个有效预约，保存时会检查冲突</text>
    <template wx:if="{{!plan.leave}}" is="shiftList" data="{{shifts:plan.shifts,base:'plan'}}"/>
    <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveDay">保存当天排班</button>
  </view>
</template>

<view class="admin-native">
  <view class="admin-toolbar"><button class="back-button" bindtap="backHome">‹ 返回小程序</button><text>{{session ? session.name : '门店后台'}}</text><button wx:if="{{session}}" class="text-button" bindtap="logout">退出</button></view>
  <view wx:if="{{checking}}" class="empty">正在恢复登录…</view>
  <view wx:elif="{{!session}}" class="login-panel panel">
    <view class="brand-icon">✦</view><text class="page-title">登录门店后台</text>
    <label class="field"><text>用户名</text><input value="{{username}}" data-path="username" bindinput="setField" placeholder="现有管理账号" maxlength="64"/></label>
    <label class="field"><text>密码</text><input password value="{{password}}" data-path="password" bindinput="setField" placeholder="请输入密码" maxlength="128" bindconfirm="login"/></label>
    <text wx:if="{{error}}" class="error-copy">{{error}}</text>
    <button class="primary-button" loading="{{loggingIn}}" disabled="{{loggingIn || !username || !password}}" bindtap="login">登录</button>
  </view>
  <block wx:else>
    <view class="page-heading"><view><button wx:if="{{section}}" class="text-button" bindtap="closeSection">‹ 其他</button><text class="page-title">{{title}}</text></view><button class="soft-button" disabled="{{loading || saving}}" bindtap="loadPage">刷新</button></view>
    <view wx:if="{{error}}" class="message error-copy" role="alert">{{error}}</view><view wx:if="{{notice}}" class="message success-copy">{{notice}}</view>
    <view wx:if="{{loading}}" class="empty">正在加载…</view>
    <block wx:else>
      <block wx:if="{{tab === 'dashboard' && !technician}}">
        <view class="panel filters"><view class="row"><picker range="{{rangeOptions}}" value="{{rangeIndex}}" bindchange="changeRange"><view class="select-input">{{rangeOptions[rangeIndex]}}</view></picker><label>自定义 <switch checked="{{customRange}}" bindchange="toggleCustom" color="#bb6f79"/></label></view><view wx:if="{{customRange}}" class="row"><picker mode="date" value="{{dateFrom}}" data-path="dateFrom" bindchange="setField"><view class="select-input">{{dateFrom || '开始日期'}}</view></picker><picker mode="date" value="{{dateTo}}" data-path="dateTo" bindchange="setField"><view class="select-input">{{dateTo || '结束日期'}}</view></picker><button class="soft-button" bindtap="loadPage">查询</button></view></view>
        <text wx:if="{{summary}}" class="muted">{{summary.rangeStart}} — {{summary.date}}</text>
        <view class="metrics"><view wx:for="{{metrics}}" wx:key="title" class="metric panel {{item.accent ? 'accent' : ''}}"><text>{{item.title}}</text><text class="metric-value">{{item.value}}</text></view></view>
        <view wx:if="{{summary}}" class="panel"><text class="card-title">净收款趋势</text><scroll-view scroll-x class="trend-scroll"><view class="trend"><view wx:for="{{trend}}" wx:key="date" class="trend-column"><view class="trend-track"><view class="trend-bar {{item.negative ? 'negative' : ''}}" style="height:{{item.height}}%"/></view><text>{{item.label}}</text></view></view></scroll-view><view class="row summary-row"><text>收款 {{summary.metrics.paidFen / 100}} 元</text><text>退款 {{summary.metrics.refundFen / 100}} 元</text></view></view>
        <view wx:if="{{summary}}" class="panel"><text class="card-title">顾客与订单</text><view class="row summary-row"><text>新客 {{summary.metrics.newCustomerCount}} 人</text><text>老客 {{summary.metrics.returningCustomerCount}} 人</text></view><view class="row summary-row"><text>完成率 {{summary.metrics.completionRate}}%</text><text>老客占比 {{summary.metrics.repeatRate}}%</text></view><text class="muted">新建 {{summary.metrics.orderCount}} 单 · 取消 {{summary.metrics.cancelledCount}} 单</text></view>
        <view wx:for="{{rankings}}" wx:for-item="group" wx:key="title" class="panel"><text class="card-title">{{group.title}}</text><view wx:for="{{group.items}}" wx:key="id" class="ranking"><text>{{index + 1}} · {{item.name}}</text><text>{{item.count}} 单</text></view><text wx:if="{{!group.items.length}}" class="muted">暂无数据</text></view>
      </block>

      <block wx:if="{{technician && (tab === 'dashboard' || tab === 'orders' || section === 'personal')}}">
        <picker mode="date" value="{{scheduleDate}}" bindchange="changeScheduleDate"><view class="select-input">{{scheduleDate}} ▾</view></picker>
        <view wx:if="{{personal}}" class="personal-title"><text>{{personal.technician.name}}</text><text class="muted">{{personal.technician.title}}</text></view>
        <template wx:if="{{tab !== 'orders'}}" is="dayPlan" data="{{plan:plan,saving:saving}}"/>
        <template wx:for="{{personal.orders}}" wx:key="id" is="orderCard" data="{{order:item,saving:saving}}"/>
        <view wx:if="{{!personal.orders.length}}" class="empty">当天没有有效预约</view>
      </block>

      <block wx:if="{{tab === 'orders' && !technician}}">
        <view class="panel"><view class="row"><text class="card-title">到店核销</text><button class="soft-button" bindtap="scanCheckIn" disabled="{{saving}}">⌗ 扫码</button></view><view class="row"><input class="flex-input" value="{{checkCode}}" data-path="checkCode" bindinput="setField" placeholder="粘贴预约核销码"/><button class="soft-button" disabled="{{saving || !checkCode}}" bindtap="redeemCode">确认</button></view></view>
        <view class="panel filters"><input value="{{query.query}}" data-path="query.query" bindinput="setField" placeholder="订单号 / 顾客 / 手机号 / 款式" bindconfirm="queryOrders"/>
          <view class="filter-grid"><picker mode="date" value="{{query.dateFrom}}" data-path="query.dateFrom" bindchange="setField"><view class="select-input">{{query.dateFrom || '开始日期'}}</view></picker><picker mode="date" value="{{query.dateTo}}" data-path="query.dateTo" bindchange="setField"><view class="select-input">{{query.dateTo || '结束日期'}}</view></picker><picker range="{{statuses}}" range-key="name" value="{{statusIndex}}" data-type="status" bindchange="filterOrders"><view class="select-input">{{statuses[statusIndex].name}} ▾</view></picker><picker range="{{technicianOptions}}" range-key="name" data-type="technicianId" bindchange="filterOrders"><view class="select-input">技师 {{query.technicianId ? '· 已筛选' : '· 全部'}} ▾</view></picker><picker range="{{serviceOptions}}" range-key="name" data-type="serviceId" bindchange="filterOrders"><view class="select-input">项目 {{query.serviceId ? '· 已筛选' : '· 全部'}} ▾</view></picker><picker range="{{workOptions}}" range-key="title" data-type="workId" bindchange="filterOrders"><view class="select-input">款式 {{query.workId ? '· 已筛选' : '· 全部'}} ▾</view></picker></view>
          <view class="actions"><button class="soft-button" bindtap="resetOrderQuery">清空</button><button class="primary-button" bindtap="queryOrders">查询</button></view></view>
        <text class="muted">共 {{orderTotal}} 单</text><template wx:for="{{orders}}" wx:key="id" is="orderCard" data="{{order:item,saving:saving}}"/>
        <view wx:if="{{!orders.length}}" class="empty">暂无符合条件的订单</view><view class="pagination"><button class="soft-button" disabled="{{orderPage <= 1}}" data-step="-1" bindtap="pageOrders">上一页</button><text>{{orderPage}} / {{orderPages}}</text><button class="soft-button" disabled="{{orderPage >= orderPages}}" data-step="1" bindtap="pageOrders">下一页</button></view>
      </block>

      <block wx:if="{{tab === 'more'}}">
        <view wx:if="{{!section}}" class="panel menu"><view wx:for="{{menu}}" wx:key="id" class="menu-row" data-id="{{item.id}}" bindtap="openSection"><text class="menu-icon">{{item.icon}}</text><text>{{item.title}}</text><text>›</text></view><view wx:if="{{!menu.length}}" class="muted">{{session.name}} · 门店工作人员</view></view>
        <block wx:elif="{{section === 'catalog'}}">
          <view class="segment"><button class="{{catalogKind === 'category' ? 'selected' : ''}}" data-kind="category" bindtap="chooseCatalogKind">大项</button><button class="{{catalogKind === 'service' ? 'selected' : ''}}" data-kind="service" bindtap="chooseCatalogKind">小项目</button><button class="{{catalogKind === 'work' ? 'selected' : ''}}" data-kind="work" bindtap="chooseCatalogKind">款式</button></view>
          <view class="filter-grid"><picker wx:if="{{catalogKind !== 'category'}}" range="{{categoryOptions}}" range-key="name" value="{{categoryIndex}}" data-type="category" bindchange="filterCatalog"><view class="select-input">{{categoryOptions[categoryIndex].name}} ▾</view></picker><picker wx:if="{{catalogKind === 'work'}}" range="{{serviceOptions}}" range-key="name" value="{{serviceIndex}}" data-type="service" bindchange="filterCatalog"><view class="select-input">{{serviceOptions[serviceIndex].name}} ▾</view></picker></view>
          <button class="primary-button" bindtap="openEditor">＋ 新增{{catalogKind === 'category' ? '大项' : catalogKind === 'service' ? '小项目' : '款式'}}</button>
          <view wx:for="{{catalogItems}}" wx:key="id" class="panel"><view class="media-row"><image wx:if="{{item.previewUrl}}" src="{{item.previewUrl}}" mode="aspectFill"/><view><text class="card-title">{{item.displayName}}</text><text class="muted">{{item.categoryName || item.serviceName}} {{item.priceLabel}}</text><text class="muted">{{item.enabled ? '已启用' : '已停用'}} · 顺序 {{item.sort}}</text></view></view><view class="actions"><button class="text-button" data-id="{{item.id}}" data-kind="{{catalogKind}}" data-sort="{{item.sort - 1}}" disabled="{{saving || item.sort <= 1}}" bindtap="reorderItem">前移</button><button class="text-button" data-id="{{item.id}}" data-kind="{{catalogKind}}" bindtap="openEditor">编辑</button><button class="text-button" data-id="{{item.id}}" data-kind="{{catalogKind}}" bindtap="archiveItem">移除</button></view></view>
        </block>
        <block wx:elif="{{section === 'featured'}}">
          <picker range="{{featuredAvailable}}" range-key="title" bindchange="addFeatured"><view class="select-input">＋ 添加精选款式 ▾</view></picker><view wx:for="{{featured}}" wx:key="id" class="panel"><view class="media-row"><image src="{{item.imageUrl}}" mode="aspectFill"/><text>{{index + 1}} · {{item.title}}</text></view><view class="actions"><button class="text-button" data-list="featured" data-index="{{index}}" data-step="-1" bindtap="moveLocal">前移</button><button class="text-button" data-list="featured" data-index="{{index}}" data-step="1" bindtap="moveLocal">后移</button><button class="text-button" data-list="featured" data-index="{{index}}" bindtap="removeLocal">移除</button></view></view><button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveFeatured">保存精选</button>
        </block>
        <block wx:elif="{{section === 'home'}}">
          <view class="panel"><text class="card-title">选款咨询微信二维码</text><image wx:if="{{qrPreview}}" class="qr-preview" src="{{qrPreview}}" mode="aspectFit"/><view class="actions"><button class="soft-button" data-target="qr" bindtap="chooseImage" disabled="{{saving}}">上传二维码</button><button class="primary-button" bindtap="saveQr" disabled="{{saving || !qrRef}}">保存二维码</button></view></view>
          <view wx:for="{{banners}}" wx:key="id" class="panel"><image wx:if="{{item.previewUrl}}" class="banner-preview" src="{{item.previewUrl}}" mode="aspectFill"/><button class="soft-button" data-target="banners[{{index}}]" bindtap="chooseImage" disabled="{{saving}}">上传并裁切 2:1 宣传图</button><view class="actions"><text>{{index + 1}} / {{banners.length}}</text><button class="text-button" data-list="banners" data-index="{{index}}" data-step="-1" bindtap="moveLocal">前移</button><button class="text-button" data-list="banners" data-index="{{index}}" data-step="1" bindtap="moveLocal">后移</button><button class="text-button" data-list="banners" data-index="{{index}}" bindtap="removeLocal">移除</button></view></view><button class="soft-button" disabled="{{banners.length >= 20 || saving}}" bindtap="addBanner">＋ 添加宣传图</button><button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveHome">保存宣传图</button>
        </block>
        <block wx:elif="{{section === 'team'}}">
          <button class="primary-button" data-kind="technician" bindtap="openEditor">＋ 新增技师</button><view wx:for="{{catalog.technicians}}" wx:key="id" class="panel"><view class="media-row"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/><view><text class="card-title">{{item.name}} · {{item.title}}</text><text class="muted">{{item.enabled ? '在职' : '已停用'}} {{item.loginName}}</text><text class="copy">{{item.bio}}</text></view></view><view class="actions"><button class="text-button" data-id="{{item.id}}" data-kind="technician" bindtap="openEditor">编辑</button><button wx:if="{{!item.bound}}" class="text-button" data-id="{{item.id}}" bindtap="openAccount">开通登录</button><button class="text-button" data-id="{{item.id}}" data-kind="technician" bindtap="archiveItem">移除</button></view></view>
        </block>
        <block wx:elif="{{section === 'schedule'}}">
          <picker mode="date" value="{{scheduleDate}}" bindchange="changeScheduleDate"><view class="select-input">{{scheduleDate}} ▾</view></picker>
          <view wx:if="{{schedule}}" class="panel"><text class="card-title">每周营业排班</text><view wx:for="{{schedule.weekly}}" wx:for-item="day" wx:for-index="di" wx:key="weekday" class="weekly-day"><view class="row"><text>周{{day.weekday === 7 ? '日' : day.weekday}}</text><label>营业 <switch checked="{{day.enabled}}" data-path="schedule.weekly[{{di}}].enabled" bindchange="setField" color="#bb6f79"/></label></view><template wx:if="{{day.enabled}}" is="shiftList" data="{{shifts:day.shifts,base:'schedule.weekly['+di+']',day:di}}"/></view><button class="primary-button" disabled="{{saving}}" loading="{{saving}}" bindtap="saveWeekly">保存每周排班</button></view>
          <picker wx:if="{{schedule.technicians.length}}" range="{{schedule.technicians}}" range-key="name" value="{{scheduleTechnicianIndex}}" bindchange="selectScheduleTechnician"><view class="select-input">{{schedule.technicians[scheduleTechnicianIndex].name}} · 当天排班 ▾</view></picker><template is="dayPlan" data="{{plan:plan,saving:saving}}"/>
        </block>
        <block wx:elif="{{section === 'settings' && settings}}">
          <view class="panel"><text class="card-title">门店资料</text><label class="field"><text>门店名称</text><input value="{{settings.store.storeName}}" data-path="settings.store.storeName" bindinput="setField"/></label><label class="field"><text>联系电话</text><input value="{{settings.store.phone}}" data-path="settings.store.phone" bindinput="setField"/></label><label class="field"><text>地址</text><input value="{{settings.store.address}}" data-path="settings.store.address" bindinput="setField"/></label><view class="filter-grid"><label class="field"><text>经度</text><input type="text" value="{{settings.store.longitude}}" data-path="settings.store.longitude" bindinput="setField"/></label><label class="field"><text>纬度</text><input type="text" value="{{settings.store.latitude}}" data-path="settings.store.latitude" bindinput="setField"/></label></view><label class="field"><text>预约须知</text><textarea value="{{settings.store.notice}}" data-path="settings.store.notice" bindinput="setField" maxlength="1000"/></label></view>
          <view class="panel"><text class="card-title">预约与积分</text><text class="muted">预约起点为 5 分钟间隔；邀请奖励在好友首次完成服务后发放给邀请方</text><label wx:for="{{settingFields}}" wx:key="path" class="field"><text>{{item.title}}</text><input type="number" value="{{item.value}}" data-path="settings.{{item.path}}" bindinput="setField"/></label><label class="field"><text>未到店违约金（元）</text><input type="digit" value="{{penaltyYuan}}" data-path="penaltyYuan" bindinput="setField"/></label></view>
          <view class="panel"><view class="row"><text class="card-title">订阅消息</text><switch checked="{{settings.notifications.enabled}}" data-path="settings.notifications.enabled" bindchange="setField" color="#bb6f79"/></view><view wx:for="{{notificationFields}}" wx:for-item="event" wx:key="id" class="notification-block"><text>{{event.title}}</text><label class="field"><text>模板 ID</text><input value="{{settings.notifications.templates[event.id].templateId}}" data-path="settings.notifications.templates.{{event.id}}.templateId" bindinput="setField"/></label><label wx:for="{{event.fields}}" wx:key="key" class="field"><text>{{item.key}}</text><input value="{{item.value}}" data-path="settings.notifications.templates.{{event.id}}.{{item.key}}" bindinput="setField"/></label></view></view><button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveSettings">保存门店设置</button>
        </block>
      </block>
    </block>
    <view class="bottom-tabs"><view class="bottom-tab {{tab === 'dashboard' ? 'active' : ''}}" data-tab="dashboard" bindtap="selectTab"><text>◒</text><text>{{technician ? '排班' : '概览'}}</text></view><view class="bottom-tab {{tab === 'orders' ? 'active' : ''}}" data-tab="orders" bindtap="selectTab"><text>◷</text><text>订单</text></view><view class="bottom-tab {{tab === 'more' ? 'active' : ''}}" data-tab="more" bindtap="selectTab"><text>☷</text><text>其他</text></view></view>
  </block>
</view>

<view wx:if="{{editor}}" class="modal-mask" catchtap="closeEditor"><scroll-view scroll-y class="modal" catchtap="stopTap"><view class="row"><text class="card-title">{{editorTitle}}</text><button class="text-button" bindtap="closeEditor">关闭</button></view><text wx:if="{{error}}" class="error-copy">{{error}}</text>
  <label class="field"><text>{{editor === 'work' ? '款式名称' : '名称'}}</text><input value="{{editor === 'work' ? draft.title : draft.name}}" data-path="draft.{{editor === 'work' ? 'title' : 'name'}}" bindinput="setField" maxlength="80"/></label>
  <picker wx:if="{{editor === 'service'}}" range="{{editorCategories}}" range-key="name" data-kind="category" bindchange="editorPick"><view class="select-input">所属大项：{{draft.categoryName || '点击选择'}} ▾</view></picker>
  <picker wx:if="{{editor === 'work'}}" range="{{editorServices}}" range-key="name" data-kind="service" bindchange="editorPick"><view class="select-input">所属项目：{{draft.serviceName || '点击选择'}} ▾</view></picker>
  <block wx:if="{{editor === 'service'}}"><view class="filter-grid"><label class="field"><text>价格（元）</text><input type="digit" value="{{draft.priceYuan}}" data-path="draft.priceYuan" bindinput="setField"/></label><label class="field"><text>时长（分钟）</text><input type="number" value="{{draft.durationMinutes}}" data-path="draft.durationMinutes" bindinput="setField"/></label></view><picker range="{{addonOptions}}" value="{{addonIndex}}" data-kind="addon" bindchange="editorPick"><view class="select-input">项目类型：{{addonOptions[addonIndex]}} ▾</view></picker><label class="field"><text>项目介绍</text><textarea value="{{draft.description}}" data-path="draft.description" bindinput="setField" maxlength="1000"/></label></block>
  <block wx:if="{{editor === 'category'}}"><view class="filter-grid"><label class="field"><text>图标（✦ ⌁ ◌ ♡ ✿ ◇）</text><input value="{{draft.icon}}" data-path="draft.icon" bindinput="setField"/></label><label class="field"><text>背景色</text><input value="{{draft.color}}" data-path="draft.color" bindinput="setField"/></label></view></block>
  <block wx:if="{{editor === 'technician'}}"><label class="field"><text>职称</text><input value="{{draft.title}}" data-path="draft.title" bindinput="setField"/></label><label class="field"><text>介绍</text><textarea value="{{draft.bio}}" data-path="draft.bio" bindinput="setField" maxlength="500"/></label><text class="field-label">可接待大项</text><checkbox-group class="checkboxes" data-path="draft.categoryIds" bindchange="setField"><label wx:for="{{editorCategories}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#bb6f79"/>{{item.name}}</label></checkbox-group></block>
  <view class="field"><text>图片</text><image wx:if="{{draft.avatarUrl || draft.imageUrl || draft.coverUrl}}" class="editor-preview" src="{{draft.avatarUrl || draft.imageUrl || draft.coverUrl}}" mode="aspectFit"/><button class="soft-button" data-target="draft" disabled="{{saving}}" bindtap="chooseImage">上传图片</button></view>
  <label class="field"><text>显示顺序</text><input type="number" value="{{draft.sort}}" data-path="draft.sort" bindinput="setField"/></label><view class="row"><text>{{editor === 'work' ? '上架' : '启用'}}</text><switch checked="{{editor === 'work' ? draft.published : draft.enabled}}" data-path="draft.{{editor === 'work' ? 'published' : 'enabled'}}" bindchange="setField" color="#bb6f79"/></view><view wx:if="{{editor === 'work'}}" class="row"><text>精选展示</text><switch checked="{{draft.featured}}" data-path="draft.featured" bindchange="setField" color="#bb6f79"/></view><button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveEditor">保存</button>
</scroll-view></view>

<view wx:if="{{refund}}" class="modal-mask" catchtap="closeRefund"><view class="modal" catchtap="stopTap"><view class="row"><text class="card-title">{{refund.retry ? '重试退款' : '订单退款'}}</text><button class="text-button" bindtap="closeRefund">关闭</button></view><text class="copy">{{refund.serviceName}} · 剩余可退 {{refund.remainingLabel}}</text><text wx:if="{{refund.retry}}" class="muted">按上次提交金额重试</text><label class="field"><text>退款金额（元）</text><input type="digit" value="{{refundYuan}}" disabled="{{refund.retry}}" data-path="refundYuan" bindinput="setField"/></label><label class="field"><text>退款原因</text><input value="{{refundReason}}" data-path="refundReason" bindinput="setField" maxlength="100"/></label><text wx:if="{{error}}" class="error-copy">{{error}}</text><button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="submitRefund">确认提交</button></view></view>

<view wx:if="{{accountTechnician}}" class="modal-mask" catchtap="closeAccount"><view class="modal" catchtap="stopTap"><view class="row"><text class="card-title">开通 {{accountTechnician.name}} 的账号</text><button class="text-button" bindtap="closeAccount">关闭</button></view><label class="field"><text>用户名</text><input value="{{accountUsername}}" data-path="accountUsername" bindinput="setField"/></label><label class="field"><text>初始密码</text><input password value="{{accountPassword}}" data-path="accountPassword" bindinput="setField" maxlength="32"/></label><text wx:if="{{error}}" class="error-copy">{{error}}</text><button class="primary-button" disabled="{{saving || !accountUsername || !accountPassword}}" loading="{{saving}}" bindtap="createAccount">开通账号</button></view></view>

<view wx:if="{{cropper}}" class="modal-mask crop-mask"><view class="crop-dialog"><text class="card-title">裁切宣传图 · 2:1</text><view class="crop-stage" style="width:{{cropper.width}}px;height:{{cropper.height}}px" catchtouchstart="cropTouchStart" catchtouchmove="cropTouchMove"><image src="{{cropper.path}}" style="width:{{cropper.imageWidth}}px;height:{{cropper.imageHeight}}px;left:{{cropper.x}}px;top:{{cropper.y}}px"/></view><text class="muted">拖动图片调整位置</text><slider min="100" max="300" value="100" activeColor="#bb6f79" bindchanging="cropZoom"/><view class="actions"><button class="soft-button" disabled="{{saving}}" bindtap="closeCropper">取消</button><button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="confirmCrop">确认上传</button></view><text wx:if="{{error}}" class="error-copy">{{error}}</text></view></view>
<canvas type="2d" id="adminCropCanvas" class="crop-canvas"/>
