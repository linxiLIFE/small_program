<view class="page-shell work-detail-page">
  <view wx:if="{{loading}}" class="skeleton work-detail-skeleton"></view>
  <empty-state wx:elif="{{error}}" title="{{error}}" button-text="重试" bindaction="loadDetail"/>
  <block wx:else>
    <view class="work-hero" bindtap="previewImage">
      <image wx:if="{{work.imageUrl}}" class="work-hero-image" mode="aspectFill" webp="{{true}}" src="{{work.imageUrl}}" />
      <view wx:else class="work-hero-fallback"><text>拾光</text></view>
      <view class="work-hero-overlay"></view>
      <view class="work-hero-caption"><text class="work-hero-title">{{work.title}}</text></view>
    </view>
    <view class="work-detail-content">
      <view wx:if="{{technicians.length}}" class="artist-section card">
        <view class="artist-section-heading"><view><text class="artist-kicker">服务技师</text><text class="artist-heading-title">选择技师</text></view><text class="artist-count">{{technicians.length}}位</text></view>
        <view class="artist-grid">
          <view wx:for="{{technicians}}" wx:key="id" class="artist-option {{selectedTechnicianId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectTechnician">
            <view class="artist-option-top"><image wx:if="{{item.avatarUrl}}" class="artist-avatar" mode="aspectFill" lazy-load="{{true}}" webp="{{true}}" src="{{item.avatarUrl}}" /><view wx:else class="artist-avatar artist-fallback">{{item.initial}}</view><view wx:if="{{selectedTechnicianId === item.id}}" class="artist-check">✓</view></view>
            <text class="artist-name">{{item.name}}</text><text class="artist-title">{{item.title}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="artist-empty card">暂无可预约技师</view>
      <view class="related-service card">
        <view class="related-copy">
          <text class="related-name">{{service.name}}</text>
          <view class="related-meta"><text>{{service.durationText}}</text><text class="related-meta-dot">·</text><text class="related-price">¥{{service.priceText}}</text></view>
        </view>
        <button class="small-book-button" bindtap="startBooking">预约</button>
      </view>
    </view>
  </block>
</view>
