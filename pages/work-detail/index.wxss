.work-detail-page {
  padding: 18rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.work-detail-skeleton {
  height: 620rpx;
  border-radius: 32rpx;
}

.work-hero {
  position: relative;
  height: 620rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #edd5d0;
  box-shadow: 0 18rpx 42rpx rgba(104, 69, 63, 0.12);
}

.work-hero-image,
.work-hero-fallback,
.work-hero-overlay {
  position: absolute;
  width: 100%;
  height: 100%;
}

.work-hero-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #edc7c2, #f4e2da 58%, #dcb9ba);
  color: #9f626b;
  font-family: inherit;
  font-size: 70rpx;
}

.work-hero-overlay {
  background: linear-gradient(180deg, rgba(38, 27, 29, 0.02) 34%, rgba(38, 27, 29, 0.74) 100%);
}

.work-hero-caption {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  padding: 18rpx 22rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 22rpx;
  background: rgba(39, 27, 29, 0.34);
}

.work-hero-title {
  display: block;
  overflow: hidden;
  color: #fffaf7;
  font-family: inherit;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.28;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.work-detail-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 18rpx;
}

.artist-section {
  padding: 24rpx;
  border-radius: 26rpx;
}

.artist-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.artist-kicker {
  display: block;
  color: #b47b7e;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.artist-heading-title {
  display: block;
  margin-top: 6rpx;
  color: #594846;
  font-size: 32rpx;
  font-weight: 700;
}

.artist-count {
  color: #a08c86;
  font-size: 22rpx;
}

.artist-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.artist-option {
  position: relative;
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid #eee1dc;
  border-radius: 22rpx;
  background: #fffdfb;
}

.artist-option.selected {
  border-color: #cd9296;
  background: #fff5f4;
  box-shadow: 0 8rpx 20rpx rgba(187, 111, 121, 0.1);
}

.artist-option-top {
  position: relative;
  display: inline-flex;
}

.artist-avatar {
  display: block;
  width: 82rpx;
  height: 82rpx;
  border: 5rpx solid #fff8f6;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(104, 69, 63, 0.12);
}

.artist-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efd9d5;
  color: #a66b70;
  font-size: 36rpx;
}

.artist-check {
  position: absolute;
  right: -8rpx;
  bottom: -4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #fff5f4;
  border-radius: 50%;
  background: #bb6f79;
  color: #fff;
  font-size: 19rpx;
  line-height: 1;
}

.artist-name,
.artist-title {
  display: block;
}

.artist-name {
  display: block;
  overflow: hidden;
  margin-top: 14rpx;
  color: #594846;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.artist-title {
  display: block;
  overflow: hidden;
  margin-top: 8rpx;
  color: #bb6f79;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.artist-empty {
  padding: 30rpx 24rpx;
  color: #a08c86;
  font-size: 24rpx;
  text-align: center;
}

.related-service {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
}

.related-copy {
  flex: 1;
  min-width: 0;
}

.related-name {
  display: block;
}

.related-name {
  overflow: hidden;
  color: #594846;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  color: #9a8581;
  font-size: 22rpx;
}

.related-meta-dot {
  color: #d5b6b0;
}

.related-price {
  color: #bb6f79;
  font-weight: 600;
}

.small-book-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 168rpx;
  width: 168rpx;
  min-width: 168rpx;
  height: 72rpx;
  margin: 0 0 0 20rpx;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  background: #bb6f79;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
  white-space: nowrap;
}

.small-book-button:active {
  background: #a85d68;
}
