.staff-page {
  padding-top: 26rpx;
}

.staff-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 10rpx 4rpx 22rpx;
}

.scan-button { margin:0; padding:0 28rpx; height:74rpx; display:flex; align-items:center; gap:12rpx; border-radius:37rpx; background:linear-gradient(135deg,#ad747d,#8d5f68); color:#fff; font-size:24rpx; box-shadow:0 14rpx 32rpx rgba(137,83,94,.2); }
.scan-button::after { border:0; }
.scan-corners { font-size:34rpx; }

.page-title {
  display: block;
  margin-top: 12rpx;
  color: #332c2b;
  font-family: inherit;
  font-size: 44rpx;
  font-weight: 700;
}

.staff-role {
  display: block;
  margin-top: 10rpx;
  color: #9a8581;
  font-size: 22rpx;
}

.staff-mark {
  color: #bb6f79;
  font-size: 42rpx;
}

.staff-tabs {
  width: 100%;
  margin: 10rpx 0 26rpx;
  white-space: nowrap;
}

.staff-tabs-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 8rpx 0;
}

.staff-tab {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #9a8581;
  font-size: 24rpx;
}

.staff-tab.active {
  background: #f5dfde;
  color: #a85d68;
  font-weight: 600;
}

.staff-loading {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.staff-skeleton {
  height: 260rpx;
}

.staff-order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.staff-order {
  padding: 24rpx;
}

.staff-order-top,
.staff-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.staff-service,
.staff-customer {
  display: block;
}

.staff-service {
  color: #594846;
  font-size: 30rpx;
  font-weight: 700;
}

.staff-customer {
  margin-top: 7rpx;
  color: #a08c86;
  font-size: 22rpx;
}

.staff-time {
  margin-top: 24rpx;
  color: #765c58;
  font-size: 25rpx;
}

.staff-addon-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fbf3ef;
}

.staff-addon-item,
.staff-addon-name {
  display: flex;
  align-items: center;
}

.staff-addon-item {
  justify-content: space-between;
  gap: 18rpx;
}

.staff-addon-name {
  min-width: 0;
  gap: 12rpx;
  color: #684f4b;
  font-size: 23rpx;
}

.staff-addon-type {
  flex: none;
  padding: 5rpx 11rpx;
  border-radius: 999rpx;
  background: #ead4d3;
  color: #a35f6a;
  font-size: 19rpx;
  font-weight: 600;
}

.staff-addon-meta {
  flex: none;
  color: #9d8179;
  font-size: 20rpx;
}

.staff-actions {
  justify-content: flex-end;
  margin-top: 20rpx;
}

.staff-button {
  min-width: 180rpx;
  height: 68rpx;
  margin: 0;
  border-radius: 15rpx;
  font-size: 24rpx;
  line-height: 68rpx;
}

.staff-button.check { background: #bb6f79; color: #ffffff; }
.staff-button.start { background: #906a95; color: #ffffff; }
.staff-button.complete { background: #6d9677; color: #ffffff; }
.staff-load-more { margin: 26rpx auto 0; border: 1rpx solid #ead7d2; border-radius: 999rpx; background: #fffaf7; color: #9f6e70; font-size: 24rpx; }
