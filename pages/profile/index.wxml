<view class="page-shell profile-page">

  <view class="profile-hero">
    <view class="profile-avatar"><image wx:if="{{profile.avatarUrl}}" mode="aspectFill" lazy-load="{{true}}" webp="{{true}}" src="{{profile.avatarUrl}}" /><text wx:else>拾</text></view>
    <view class="profile-copy"><view wx:if="{{!editingName}}" class="profile-name-row"><text class="profile-name">{{profile.nickname || '拾光访客'}}</text><button class="name-edit-button" bindtap="editNickname">编辑</button></view><view wx:else class="profile-name-editor"><input class="name-input" value="{{draftNickname}}" maxlength="20" focus="{{true}}" bindinput="inputNickname"/><view class="name-editor-actions"><button bindtap="cancelNickname">取消</button><button bindtap="saveNickname">保存</button></view></view><text class="profile-phone">{{profile.phoneLabel || '未绑定'}}</text></view>
    <text class="profile-star">✦</text>
  </view>

  <view class="points-card" bindtap="openPoints">
    <view><text class="points-number">{{profile.points || 0}}</text><text class="points-unit">积分</text></view>
    <view class="points-right"><text>积分明细</text><text class="points-arrow">›</text></view>
  </view>

  <view class="orders-overview card">
    <view class="profile-section-heading"><text>我的订单</text><text bindtap="openOrders">全部 ›</text></view>
    <view class="order-summary-grid"><view wx:for="{{orderSummary}}" wx:key="id" class="order-summary-item" data-status="{{item.id}}" bindtap="openOrdersStatus"><view class="order-summary-icon {{item.id === 'PENDING_PAYMENT' ? 'rose' : item.id === 'RESERVED' ? 'sand' : item.id === 'ACTIVE_SERVICE' ? 'plum' : 'green'}}">{{item.icon}}</view><text class="order-summary-count">{{item.count}}</text><text class="order-summary-label">{{item.label}}</text></view></view>
  </view>

  <view class="reminder-card card" bindtap="enableReminders"><view class="menu-icon rose">◌</view><view class="menu-copy"><text>微信预约提醒</text><text>预约成功、到店与未到店退款</text></view><text class="menu-arrow">›</text></view>

  <view class="menu-card card">
    <view class="menu-item" bindtap="contactService"><view class="menu-icon sand">⌁</view><view class="menu-copy"><text>联系客服</text></view><text class="menu-arrow">›</text></view>
    <view class="divider"></view>
    <view class="menu-item" bindtap="privacy"><view class="menu-icon plum">♡</view><view class="menu-copy"><text>隐私与授权</text></view><text class="menu-arrow">›</text></view>
  </view>

  <view wx:if="{{!profile.phone && !profile.phoneMasked}}" class="phone-reminder card"><view><text class="reminder-title">预约前绑定手机号</text></view><button open-type="getPhoneNumber|agreePrivacyAuthorization" phone-number-no-quota-toast="false" bindgetphonenumber="handleGetPhoneNumber" bindagreeprivacyauthorization="handleAgreePrivacyAuthorization">去绑定</button></view>

</view>
