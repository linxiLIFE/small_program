<view class="page-shell profile-page">

  <view class="profile-hero">
    <view class="profile-avatar"><image wx:if="{{profile.avatarUrl}}" mode="aspectFill" src="{{profile.avatarUrl}}" /><text wx:else>拾</text></view>
    <view class="profile-copy"><text class="profile-name">{{profile.nickname || '拾光访客'}}</text><text class="profile-phone">{{profile.phoneLabel || '未绑定'}}</text></view>
    <text class="profile-star">✦</text>
  </view>

  <view class="points-card" bindtap="openPoints">
    <view><text class="points-number">{{profile.points || 0}}</text><text class="points-unit">积分</text></view>
    <view class="points-right"><text>查看积分明细</text><text class="points-arrow">›</text></view>
  </view>

  <view class="menu-card card">
    <view class="menu-item" bindtap="openOrders"><view class="menu-icon rose">◷</view><view class="menu-copy"><text>预约记录</text></view><text class="menu-arrow">›</text></view>
    <view class="divider"></view>
    <view class="menu-item" bindtap="contactService"><view class="menu-icon sand">⌁</view><view class="menu-copy"><text>联系客服</text></view><text class="menu-arrow">›</text></view>
    <view class="divider"></view>
    <view class="menu-item" bindtap="privacy"><view class="menu-icon plum">♡</view><view class="menu-copy"><text>隐私与授权</text></view><text class="menu-arrow">›</text></view>
  </view>

  <view wx:if="{{!profile.phone && !profile.phoneMasked}}" class="phone-reminder card"><view><text class="reminder-title">预约前绑定手机号</text></view><button open-type="getPhoneNumber|agreePrivacyAuthorization" phone-number-no-quota-toast="false" bindgetphonenumber="handleGetPhoneNumber" bindagreeprivacyauthorization="handleAgreePrivacyAuthorization">去绑定</button></view>

</view>