<view class="page-shell order-detail-page">
  <view wx:if="{{loading}}"><view class="skeleton detail-status-skeleton"></view><view class="skeleton detail-order-skeleton"></view></view>
  <view wx:elif="{{loadError && !order.id}}" class="load-error card"><text>{{loadError}}</text><button class="primary-button" bindtap="retryLoadOrder">重新加载</button></view>
  <block wx:else>
    <view wx:if="{{loadError}}" class="inline-load-error"><text>{{loadError}}</text><button bindtap="retryLoadOrder">重试</button></view>
    <view class="order-status-card card">
      <view class="status-top">
        <view class="status-heading">
          <text class="status-label">预约状态</text>
          <text class="status-title status-{{order.status}}">{{order.statusLabel}}</text>
        </view>
      </view>
      <view class="appointment-focus">
        <text class="focus-label">预约时间</text>
        <text class="focus-time">{{order.timeLabel}}</text>
        <view wx:if="{{order.status === 'PENDING_PAYMENT' && order.countdownText}}" class="payment-countdown {{order.countdownUrgent ? 'urgent' : ''}}">
          <view class="countdown-indicator"></view>
          <text class="countdown-caption">剩余支付</text>
          <text class="countdown-value">{{order.countdownText}}</text>
          <text class="countdown-tip">超时自动取消</text>
        </view>
      </view>
    </view>

    <view wx:if="{{order.canShowCheckInCode}}" class="checkin-code-card card">
      <view class="checkin-code-head"><text>到店核销码</text><button bindtap="enableCheckInReminder">开启核销提醒</button></view>
      <view class="inline-qr-frame"><view wx:if="{{qrLoading}}" class="qr-loading">生成中</view><image wx:else src="{{qrDataUrl}}" mode="aspectFit" /></view>
      <text class="inline-qr-time">{{order.timeLabel}}</text>
    </view>
    <view wx:elif="{{order.arrivedAt}}" class="checkin-card card"><view class="checkin-icon">✓</view><view class="checkin-copy"><text class="checkin-title">预约已核销</text></view></view>


    <view class="detail-card card">
      <view class="detail-card-heading"><text class="section-title">服务内容</text></view>
      <view class="service-summary">
        <view class="service-summary-image">
          <image wx:if="{{order.work && order.work.imageUrl}}" src="{{order.work.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" webp="{{true}}" />
          <view wx:else class="service-summary-fallback">预约</view>
        </view>
        <view class="service-summary-copy">
          <text class="service-summary-title">{{order.displayTitle}}</text>
          <text wx:if="{{order.showServiceSubtitle}}" class="service-summary-service">{{order.serviceName}}</text>
          <text wx:if="{{order.categoryName}}" class="service-summary-category">{{order.categoryName}}</text>
        </view>
      </view>
      <view class="detail-grid">
        <view class="detail-grid-item">
          <text class="row-label">服务技师</text>
          <text class="row-value">{{order.technicianName || '待安排'}}</text>
        </view>
        <view class="detail-grid-item">
          <text class="row-label">服务时长</text>
          <text class="row-value">{{order.durationText}}</text>
        </view>
      </view>
    </view>

    <view class="price-card card">
      <view class="detail-card-heading"><text class="section-title">费用明细</text></view>
      <view class="detail-row"><text class="row-label">项目金额</text><text class="row-value">{{order.totalText}}</text></view>
      <view class="detail-row"><text class="row-label">积分抵扣</text><text class="row-value discount">- {{order.discountText}}</text></view>
      <view class="divider"></view>
      <view class="detail-row total-row"><text class="row-label">{{order.paidLabel}}</text><text class="row-value total">{{order.paidText}}</text></view>
      <view wx:if="{{order.refundStatus}}" class="refund-row" bindtap="showRefundStatus">
        <view class="refund-copy">
          <text class="refund-title">退款状态</text>
          <text class="refund-status">{{order.refundStatusLabel}} · 已退 {{order.refundedText}}<text wx:if="{{order.partiallyRefunded}}"> · 剩余 {{order.remainingRefundText}}</text></text>
        </view>
        <text class="refund-action">查看进度</text>
      </view>
    </view>

    <view class="order-info-card card">
      <view class="detail-card-heading"><text class="section-title">订单信息</text></view>
      <view class="detail-row"><text class="row-label">订单号</text><text class="row-value order-number">{{order.id}}</text></view>
      <view class="detail-row"><text class="row-label">下单时间</text><text class="row-value">{{order.createdAtText}}</text></view>
      <view wx:if="{{order.paidAtText}}" class="detail-row"><text class="row-label">支付时间</text><text class="row-value">{{order.paidAtText}}</text></view>
    </view>

    <view class="timeline-card card">
      <view class="detail-card-heading"><text class="section-title">订单进度</text></view>
      <view class="timeline-item active"><view class="timeline-dot"></view><view><text>提交预约</text><text class="timeline-meta">预约信息已提交</text></view></view>
      <view class="timeline-line"></view>
      <view class="timeline-item {{order.paymentProgressActive ? 'active' : ''}}"><view class="timeline-dot"></view><view><text>支付确认</text><text class="timeline-meta">{{order.paymentProgressLabel}}</text></view></view>
      <view class="timeline-line"></view>
      <view class="timeline-item {{order.serviceCompleted ? 'active' : ''}}"><view class="timeline-dot"></view><view><text>到店完成</text><text class="timeline-meta">{{order.serviceCompleted ? '本次服务已完成' : '服务完成后更新'}}</text></view></view>
    </view>

    <view wx:if="{{paymentConfirming}}" class="action-bar safe-bottom">
      <button class="action-button primary" loading="{{paymentChecking}}" disabled="{{paymentChecking}}" bindtap="retryPaymentConfirmation">重新确认支付结果</button>
    </view>
    <view wx:elif="{{actions.length}}" class="action-bar safe-bottom">
      <button wx:for="{{actions}}" wx:key="id" class="action-button {{item.type}}" loading="{{item.id === 'pay' && paying}}" disabled="{{paying || paymentConfirming}}" data-action="{{item.id}}" bindtap="handleAction">{{item.text}}</button>
    </view>
  </block>
</view>
