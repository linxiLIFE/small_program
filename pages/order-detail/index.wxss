.order-detail-page {
  padding-top: 26rpx;
  padding-bottom: 70rpx;
}

.detail-status-skeleton {
  height: 246rpx;
}

.detail-order-skeleton {
  height: 720rpx;
  margin-top: 20rpx;
}

.order-status-card,
.detail-card,
.price-card,
.timeline-card {
  padding: 28rpx 24rpx;
}

.status-top {
  display: block;
}

.detail-card-heading,
.detail-row,
.refund-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-heading {
  min-width: 0;
}

.status-label,
.focus-label,
.refund-title {
  display: block;
  color: #a08c86;
  font-size: 22rpx;
}

.status-title {
  display: block;
  margin-top: 8rpx;
  color: #594846;
  font-family: inherit;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.status-title.status-PENDING_PAYMENT { color: #aa7832; }
.status-title.status-RESERVED { color: #af606b; }
.status-title.status-ARRIVED,
.status-title.status-IN_SERVICE { color: #865f8d; }
.status-title.status-COMPLETED { color: #5d8a67; }
.status-title.status-CANCELLED,
.status-title.status-CANCELLED_BY_USER,
.status-title.status-CANCELLED_NO_SHOW { color: #988684; }

.appointment-focus {
  margin-top: 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff5f2;
}

.focus-time {
  display: block;
  margin-top: 8rpx;
  color: #765c58;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
}

.payment-countdown {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #efd9d3;
  color: #a97868;
}

.countdown-indicator {
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #d49a72;
  box-shadow: 0 0 0 5rpx rgba(212, 154, 114, 0.12);
}

.countdown-caption,
.countdown-tip {
  flex: 0 0 auto;
  white-space: nowrap;
}

.countdown-caption {
  font-size: 20rpx;
}

.countdown-value {
  flex: 0 0 auto;
  margin-left: 10rpx;
  color: #b86670;
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1;
}

.countdown-tip {
  margin-left: auto;
  color: #b19d98;
  font-size: 19rpx;
}

.payment-countdown.urgent .countdown-indicator {
  background: #c86e63;
  box-shadow: 0 0 0 5rpx rgba(200, 110, 99, 0.14);
}

.payment-countdown.urgent .countdown-value {
  color: #c35f61;
}

.detail-card,
.price-card,
.timeline-card {
  margin-top: 20rpx;
}

.detail-card-heading .section-title {
  font-size: 32rpx;
}

.service-summary {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f2e9e5;
}

.service-summary-image {
  flex: 0 0 124rpx;
  width: 124rpx;
  height: 124rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #f0e1dd;
}

.service-summary-image image,
.service-summary-fallback {
  display: block;
  width: 100%;
  height: 100%;
}

.service-summary-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #aa777b;
  font-size: 24rpx;
}

.service-summary-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.service-summary-title,
.service-summary-service,
.service-summary-category,
.refund-title,
.refund-status {
  display: block;
}

.service-summary-title {
  overflow: hidden;
  color: #594846;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-summary-service {
  margin-top: 8rpx;
  overflow: hidden;
  color: #806d68;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-summary-category {
  margin-top: 8rpx;
  color: #bb6f79;
  font-size: 21rpx;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 22rpx;
}

.detail-grid-item {
  min-width: 0;
}

.detail-grid-item .row-value {
  display: block;
  max-width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-row {
  margin-top: 24rpx;
  color: #806d68;
  font-size: 25rpx;
}

.row-label {
  color: #a08c86;
}

.row-value {
  max-width: 68%;
  color: #594846;
  text-align: right;
}

.row-value.discount {
  color: #bb6f79;
}

.total-row {
  margin-top: 20rpx;
}

.row-value.total {
  color: #bb6f79;
  font-family: inherit;
  font-size: 38rpx;
  font-weight: 700;
}

.refund-row {
  margin: 24rpx -24rpx -28rpx;
  padding: 20rpx 24rpx;
  border-radius: 0 0 28rpx 28rpx;
  background: #fff7ed;
  color: #a87949;
  font-size: 23rpx;
}

.refund-status {
  margin-top: 6rpx;
  color: #a87949;
  font-size: 21rpx;
}

.refund-action {
  color: #bb6f79;
  font-size: 22rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  color: #b09d98;
  font-size: 25rpx;
}

.timeline-item.active {
  color: #765c58;
}

.timeline-dot {
  flex: 0 0 18rpx;
  width: 18rpx;
  height: 18rpx;
  margin: 6rpx 18rpx 0 2rpx;
  border: 4rpx solid #e8d8d3;
  border-radius: 50%;
  background: #ffffff;
}

.active .timeline-dot {
  border-color: #e4b2b4;
  background: #bb6f79;
}

.timeline-meta {
  display: block;
  margin-top: 7rpx;
  color: #b09d98;
  font-size: 21rpx;
}

.timeline-line {
  width: 2rpx;
  height: 34rpx;
  margin: 4rpx 0 4rpx 10rpx;
  background: #eee1dc;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 82rpx;
  margin: 0;
  padding: 0;
  border-radius: 17rpx;
  font-size: 27rpx;
  line-height: 1;
}

.action-button.primary {
  background: #bb6f79;
  color: #ffffff;
}

.action-button.ghost {
  border: 1rpx solid #ead8d2;
  background: #fffdfb;
  color: #765c58;
}

.action-button.danger {
  border: 1rpx solid #e7b4ae;
  background: #fff7f5;
  color: #c2675f;
}

.order-footnote {
  margin-top: 26rpx;
  color: #b19d98;
  font-size: 20rpx;
  text-align: center;
}
