<view class="page-shell detail-page">
  <view wx:if="{{loading}}" class="detail-loading">
    <view class="skeleton detail-cover-skeleton"></view>
    <view class="skeleton detail-line large"></view>
    <view class="skeleton detail-line"></view>
  </view>

  <empty-state wx:elif="{{error}}" title="{{error}}" button-text="重试" bindaction="loadDetail"/>
  <block wx:else>
    <view class="detail-cover-wrap">
      <image wx:if="{{service.coverUrl && !coverImageError}}" class="detail-cover" mode="aspectFill" webp="{{true}}" src="{{coverFallbackAttempted ? service.coverRemoteUrl : service.coverUrl}}" binderror="handleCoverImageError" />
      <view wx:else class="detail-cover-fallback"><text>四个小姐姐的店</text><text>{{service.categoryName}}</text></view>
      <view class="cover-overlay"></view>
      <view class="cover-caption"><text class="cover-title">{{service.name}}</text></view>
    </view>

    <view class="detail-content">
      <view class="price-row">
        <text class="detail-price">¥{{service.priceText}}</text>
        <text class="detail-duration">约 {{service.durationText}}</text>
      </view>

    </view>

    <view class="bottom-bar safe-bottom"><button class="primary-button" bindtap="startBooking">选择款式</button></view>
  </block>
</view>
