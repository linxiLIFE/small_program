.points-page {
  padding-top: 26rpx;
}

.points-heading {
  padding: 10rpx 4rpx 24rpx;
}

.page-title {
  display: block;
  margin-top: 12rpx;
  color: #332c2b;
  font-family: inherit;
  font-size: 44rpx;
  font-weight: 700;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #9a8581;
  font-size: 23rpx;
}

.points-balance-card {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 220rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #9b626e, #bd7d84 62%, #d39a97);
  box-shadow: 0 18rpx 36rpx rgba(164, 98, 108, 0.2);
}

.debt-note {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #efd7c8;
  border-radius: 18rpx;
  background: #fff4e9;
  color: #a87952;
  font-size: 22rpx;
  line-height: 1.55;
}

.invite-panel { margin-top:22rpx; padding:28rpx; overflow:hidden; background:linear-gradient(145deg,#fffaf7,#fff5f0); }
.invite-heading,.invite-code-row,.invite-bind-row,.invite-bound { display:flex; align-items:center; }
.invite-heading { justify-content:space-between; gap:20rpx; }
.invite-title,.invite-subtitle,.invite-field-label,.invite-hint,.invite-bound text { display:block; }
.invite-title { color:#5c4643; font-size:29rpx; font-weight:700; }
.invite-subtitle { margin-top:7rpx; color:#a18780; font-size:21rpx; line-height:1.5; }
.invite-mark { color:#c68183; font-size:42rpx; }
.invite-code-block { margin-top:26rpx; padding:24rpx; border:1rpx solid #efdeda; border-radius:22rpx; background:#fff; }
.invite-field-label { color:#927872; font-size:21rpx; font-weight:600; }
.invite-code-row { justify-content:space-between; gap:18rpx; margin-top:12rpx; }
.invite-code { min-width:0; color:#8f5260; font-size:38rpx; font-weight:750; letter-spacing:6rpx; overflow-wrap:anywhere; }
.invite-code-row button,.invite-bind-row button { flex:none; margin:0; border-radius:17rpx; background:#a96d76; color:#fff; font-size:22rpx; }
.invite-code-row button { height:58rpx; padding:0 22rpx; line-height:58rpx; }
.invite-code-row button[disabled],.invite-bind-row button[disabled] { background:#d9c4c1; color:#fffaf7; }
.invite-code-row button::after,.invite-bind-row button::after { border:0; }
.invite-hint { margin-top:13rpx; color:#b19b94; font-size:19rpx; line-height:1.5; }
.invite-divider { height:1rpx; margin:26rpx 0; background:#efe2de; }
.invite-bind-row { gap:12rpx; margin-top:12rpx; }
.invite-bind-row input { flex:1; min-width:0; height:72rpx; padding:0 20rpx; border:1rpx solid #eee0dc; border-radius:17rpx; background:#fff; color:#604b47; font-size:23rpx; letter-spacing:2rpx; box-sizing:border-box; }
.invite-bind-row button { min-width:154rpx; height:72rpx; padding:0 20rpx; line-height:72rpx; }
.invite-bound { gap:15rpx; padding:18rpx 20rpx; border-radius:18rpx; background:#f2f7f1; }
.invite-bound-icon { display:flex; align-items:center; justify-content:center; width:44rpx; height:44rpx; border-radius:50%; background:#719177; color:#fff; font-size:24rpx; }
.invite-bound text:first-child { color:#607763; font-size:23rpx; font-weight:650; }
.invite-bound text:last-child { margin-top:4rpx; color:#95a397; font-size:19rpx; }

.balance-label,
.frozen text {
  display: block;
  color: rgba(255, 250, 247, 0.75);
  font-size: 22rpx;
}

.balance-number {
  display: block;
  margin-top: 4rpx;
  color: #fffaf7;
  font-family: inherit;
  font-size: 72rpx;
  font-weight: 700;
}

.frozen {
  text-align: right;
}

.frozen text:last-child {
  margin-top: 8rpx;
  color: #fffaf7;
  font-family: inherit;
  font-size: 34rpx;
}

.rule-card {
  margin-top: 22rpx;
  padding: 24rpx;
  background: #fff6ed;
}

.rule-title,
.rule-copy {
  display: block;
}

.rule-title {
  color: #8b673d;
  font-size: 26rpx;
  font-weight: 700;
}

.rule-copy {
  margin-top: 10rpx;
  color: #a17d51;
  font-size: 22rpx;
  line-height: 1.65;
}

.ledger-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 44rpx;
}

.ledger-heading .section-title {
  font-size: 34rpx;
}

.ledger-list {
  margin-top: 20rpx;
  padding: 4rpx 24rpx;
}

.ledger-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid #f2e9e5;
}

.ledger-item:last-child {
  border-bottom: 0;
}

.ledger-description,
.ledger-time {
  display: block;
}

.ledger-description {
  color: #765c58;
  font-size: 25rpx;
}

.ledger-time {
  margin-top: 6rpx;
  color: #b19d98;
  font-size: 20rpx;
}

.ledger-amount {
  font-family: inherit;
  font-size: 30rpx;
  font-weight: 700;
}

.ledger-amount.positive { color: #69936f; }
.ledger-amount.negative { color: #bb6f79; }

.ledger-skeleton {
  height: 300rpx;
  margin-top: 20rpx;
}

.empty-ledger {
  margin-top: 30rpx;
  color: #a08c86;
  text-align: center;
}
