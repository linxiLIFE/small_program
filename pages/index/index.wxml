<view class="page-shell home-page">
  <view class="home-header"><text class="store-name">{{store.storeName || '拾光美研'}}</text><button class="contact-button" bindtap="makePhoneCall">联系门店</button></view>
  <view class="home-hero" bindtap="goServices"><image wx:if="{{works[0].imageUrl || services[0].coverUrl}}" src="{{works[0].imageUrl || services[0].coverUrl}}" mode="aspectFill"/><view class="hero-shade"></view><button class="hero-action">选款预约 <text>↗</text></button></view>
  <view class="location-card card"><text class="location-symbol">⌖</text><view><text class="location-title">门店位置</text><text class="location-address">{{store.address || '地址待设置'}}</text></view></view>
  <view class="section-block"><section-title title="项目" link-text="全部" bindlink="goServices"/><view class="category-grid"><view wx:for="{{categories}}" wx:key="id" class="category-item" data-id="{{item.id}}" bindtap="handleCategoryTap"><text class="category-icon">{{item.icon}}</text><text>{{item.name}}</text><text class="category-arrow">↗</text></view></view></view>
  <view wx:if="{{works.length}}" class="section-block"><section-title title="精选款式" link-text="全部" bindlink="goServices"/><view class="home-services"><work-card wx:for="{{works}}" wx:key="id" work="{{item}}" bindselect="handleWorkTap"/></view></view>
</view>
