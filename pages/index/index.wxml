<view class="page-shell home-page">
  <view class="home-header"><text class="store-name">{{store.storeName || '四个小姐姐的店'}}</text><button class="contact-button" bindtap="makePhoneCall">联系门店</button></view>
  <empty-state wx:if="{{error}}" title="{{error}}" button-text="重试" bindaction="loadHome"/>
  <swiper wx:if="{{banners.length}}" class="home-banner" indicator-dots="{{banners.length > 1}}" autoplay="{{banners.length > 1}}" circular interval="4500" indicator-color="rgba(255,255,255,.5)" indicator-active-color="#fff"><swiper-item wx:for="{{banners}}" wx:key="id"><image wx:if="{{!item.imageError}}" src="{{item.imageFallbackAttempted ? item.imageRemoteUrl : item.imageUrl}}" mode="aspectFill" lazy-load="{{item.lazy}}" webp="{{true}}" data-index="{{index}}" bindtap="previewBanner" binderror="handleBannerImageError"/><view wx:else class="home-banner-fallback"/></swiper-item></swiper>
  <view class="location-card card" bindtap="openLocation"><text class="location-symbol">⌖</text><view><text class="location-title">门店位置</text><text class="location-address">{{store.address || '地址待设置'}}</text></view><text class="location-arrow">›</text></view>
  <view class="style-contact-card card" bindtap="contactForStyles"><view><text class="style-contact-title">选款拿不定主意？加微信聊聊</text><text class="style-contact-copy">点击查看微信二维码，帮你挑选适合的款式</text></view><text class="style-contact-action">查看二维码 ›</text></view>
  <view class="section-block"><section-title title="选择大项" link-text="全部" bindlink="goServices"/><view class="category-grid"><view wx:for="{{categories}}" wx:key="id" class="category-item" data-id="{{item.id}}" bindtap="handleCategoryTap"><text class="category-icon">{{item.icon}}</text><text class="category-name">{{item.name}}</text><text class="category-count">{{item.serviceCountText}}</text><text class="category-arrow">↗</text></view></view></view>
  <view wx:if="{{works.length}}" class="section-block"><section-title title="款式" link-text="去选款" bindlink="goServices"/><view class="home-services"><work-card wx:for="{{works}}" wx:key="id" work="{{item}}" bindselect="handleWorkTap"/></view></view>
</view>

<view wx:if="{{showWechatQr}}" class="wechat-qr-mask" catchtap="closeWechatQr" catchtouchmove="stopQrTap">
  <view class="wechat-qr-dialog" catchtap="stopQrTap">
    <text class="wechat-qr-title">加微信，帮你选款</text>
    <image wx:if="{{store.wechatQrUrl && !wechatQrError}}" class="wechat-qr-image" src="{{store.wechatQrUrl}}" mode="aspectFit" show-menu-by-longpress="{{true}}" bindtap="previewWechatQr" binderror="handleWechatQrError"/>
    <text wx:else class="wechat-qr-empty">{{wechatQrError ? '二维码加载失败，请稍后重试' : '门店微信二维码暂未设置'}}</text>
    <text wx:if="{{store.wechatQrUrl && !wechatQrError}}" class="wechat-qr-tip">点击放大，长按识别二维码</text>
    <button class="wechat-qr-close" bindtap="closeWechatQr">关闭</button>
  </view>
</view>
