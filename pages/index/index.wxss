.home-header{display:flex;align-items:center;justify-content:space-between;padding:12rpx 0 30rpx}.store-name{min-width:0;overflow:hidden;font-size:42rpx;font-weight:600;letter-spacing:4rpx;text-overflow:ellipsis;white-space:nowrap}.contact-button{flex:0 0 auto;width:auto;min-width:126rpx;height:54rpx;margin:0 0 0 18rpx;padding:0 18rpx;border:1rpx solid #ead7d2;border-radius:28rpx;background:#fff8f4;color:#795b59;font-size:21rpx;line-height:52rpx}.home-hero{height:660rpx;border-radius:32rpx;overflow:hidden;position:relative;background:#e9d5cd}.home-hero image{width:100%;height:100%}.hero-shade{position:absolute;inset:0;background:linear-gradient(transparent 55%,rgba(39,26,24,.5))}.hero-action{position:absolute;bottom:34rpx;left:32rpx;right:32rpx;background:#fffaf3;color:#503c37;border-radius:18rpx;line-height:88rpx;font-size:28rpx;text-align:left;padding:0 28rpx}.hero-action text{float:right}.location-card{display:flex;gap:22rpx;align-items:center;margin-top:24rpx;padding:28rpx}.location-symbol{font-size:44rpx;color:#a3666e}.location-title{display:block;font-size:25rpx;margin-bottom:10rpx}.location-address{font-size:25rpx;line-height:1.6;color:#806b65;word-break:break-all}.section-block{margin-top:42rpx}.category-grid{display:flex;gap:14rpx}.category-item{flex:1;padding:26rpx 18rpx;border-radius:22rpx;background:#f0e3df;font-size:27rpx;position:relative}.category-item:nth-child(2){background:#eee7db}.category-item:nth-child(3){background:#e9dfe5}.category-icon{display:block;font-size:40rpx;margin-bottom:28rpx;color:#a77276}.category-arrow{position:absolute;right:16rpx;bottom:25rpx;color:#9b7f76}.home-services{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx 18rpx}.home-service{overflow:hidden;background:#fff;border-radius:22rpx}.home-service image{display:block;width:100%;height:330rpx}.home-service>text{display:block;padding:22rpx 18rpx;font-size:26rpx;font-weight:500}
.home-banner{width:100%;height:400rpx;border-radius:28rpx;overflow:hidden;background:#eee3dc}.home-banner swiper-item{height:100%}.home-banner image{width:100%;height:100%;display:block}.location-card>view{flex:1;min-width:0}.location-arrow{color:#a98280;font-size:40rpx}.category-grid{flex-wrap:wrap}.category-item{min-width:25%;box-sizing:border-box}.category-name{display:block;color:#594846;font-size:27rpx;font-weight:600}.category-count{display:block;margin-top:10rpx;color:#9d817b;font-size:20rpx}

.notification-prompt{position:relative;overflow:hidden;margin-bottom:24rpx;padding:28rpx 28rpx 24rpx;border:1rpx solid #efd9d5;border-radius:30rpx;background:linear-gradient(135deg,#fff8f5 0%,#f8ece9 58%,#f5eee2 100%);box-shadow:0 18rpx 42rpx rgba(170,103,111,.12)}
.notification-prompt-orb{position:absolute;border-radius:50%;pointer-events:none}.notification-prompt-orb.orb-one{top:-72rpx;right:-46rpx;width:190rpx;height:190rpx;background:rgba(214,157,153,.18)}.notification-prompt-orb.orb-two{right:150rpx;bottom:-105rpx;width:190rpx;height:190rpx;background:rgba(232,205,170,.18)}
.notification-prompt-head{position:relative;z-index:1;display:flex;align-items:center;gap:18rpx}.notification-bell{position:relative;display:flex;flex:0 0 auto;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:25rpx;background:linear-gradient(145deg,#c98289,#ab626e);box-shadow:0 12rpx 22rpx rgba(170,98,110,.22)}.notification-bell-body{position:absolute;top:20rpx;width:34rpx;height:29rpx;border:4rpx solid #fff8f5;border-bottom:0;border-radius:20rpx 20rpx 6rpx 6rpx}.notification-bell-body::after{position:absolute;right:-8rpx;bottom:-5rpx;left:-8rpx;height:4rpx;border-radius:4rpx;background:#fff8f5;content:""}.notification-bell-clapper{position:absolute;bottom:15rpx;width:9rpx;height:9rpx;border-radius:50%;background:#fff8f5}.notification-prompt-copy{flex:1;min-width:0}.notification-prompt-title{display:block;color:#5c4543;font-size:29rpx;font-weight:700;letter-spacing:1rpx}.notification-prompt-subtitle{display:block;margin-top:8rpx;color:#987a76;font-size:21rpx;line-height:1.5}.notification-prompt-close{display:flex;flex:0 0 auto;align-items:center;justify-content:center;width:46rpx;height:46rpx;margin:0;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.55);color:#b9948e;font-size:34rpx;font-weight:300;line-height:44rpx}.notification-prompt-close::after{border:0}.notification-prompt-foot{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid rgba(185,127,126,.16)}.notification-prompt-note{display:flex;align-items:center;min-width:0;color:#a1847d;font-size:20rpx}.notification-prompt-dot{width:10rpx;height:10rpx;margin-right:9rpx;border-radius:50%;background:#c98087;box-shadow:0 0 0 6rpx rgba(201,128,135,.12)}.notification-prompt-button{flex:0 0 auto;height:62rpx;margin:0 0 0 18rpx;padding:0 24rpx;border-radius:18rpx;background:#b86d78;color:#fff;font-size:23rpx;font-weight:600;line-height:62rpx;box-shadow:0 10rpx 18rpx rgba(173,99,110,.2)}.notification-prompt-button::after{border:0}
