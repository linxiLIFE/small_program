.home-page {
  padding-top: 20rpx;
}

.demo-banner {
  margin-bottom: 20rpx;
  padding: 14rpx 20rpx;
  border: 1rpx solid #ead5b9;
  border-radius: 14rpx;
  background: #fff7e8;
  color: #9a743e;
  font-size: 22rpx;
  line-height: 1.45;
}

.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx 4rpx 30rpx;
}

.greeting,
.store-name {
  display: block;
}

.greeting {
  margin-top: 12rpx;
  color: #765c58;
  font-size: 25rpx;
}

.store-name {
  margin-top: 5rpx;
  color: #332c2b;
  font-family: Georgia, "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 700;
}

.header-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 1rpx solid #e9cfd0;
  border-radius: 50%;
  color: #bb6f79;
  font-family: Georgia, serif;
  font-size: 42rpx;
}

.hero-card {
  position: relative;
  min-height: 436rpx;
  overflow: hidden;
  padding: 44rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #c9858a 0%, #b96d78 54%, #8e5868 100%);
  box-shadow: 0 22rpx 48rpx rgba(157, 94, 104, 0.25);
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 74%;
}

.hero-kicker,
.hero-title,
.hero-desc {
  display: block;
  color: #fffaf7;
}

.hero-kicker {
  font-size: 23rpx;
  opacity: 0.82;
}

.hero-title {
  margin-top: 28rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-desc {
  margin-top: 22rpx;
  font-size: 23rpx;
  opacity: 0.78;
}

.hero-button {
  width: 260rpx;
  height: 70rpx;
  margin: 34rpx 0 0;
  border-radius: 16rpx;
  background: #fffaf7;
  color: #a65f6a;
  font-size: 24rpx;
  line-height: 70rpx;
  text-align: center;
}

.hero-button text {
  margin-left: 10rpx;
  font-size: 34rpx;
  vertical-align: -2rpx;
}

.hero-orbit {
  position: absolute;
  border: 1rpx solid rgba(255, 250, 247, 0.3);
  border-radius: 50%;
}

.orbit-one {
  top: -86rpx;
  right: -110rpx;
  width: 360rpx;
  height: 360rpx;
}

.orbit-two {
  right: -10rpx;
  bottom: -114rpx;
  width: 300rpx;
  height: 300rpx;
}

.hero-flower {
  position: absolute;
  right: 68rpx;
  top: 130rpx;
  color: rgba(255, 250, 247, 0.72);
  font-size: 128rpx;
  transform: rotate(18deg);
}

.quick-info {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 24rpx 22rpx;
}

.quick-item {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #f9e9e5;
  color: #bb6f79;
  font-size: 28rpx;
}

.quick-label,
.quick-value {
  display: block;
}

.quick-label {
  color: #6d5651;
  font-size: 23rpx;
  font-weight: 600;
}

.quick-value {
  overflow: hidden;
  margin-top: 5rpx;
  color: #a08c86;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-divider {
  width: 1rpx;
  height: 54rpx;
  margin: 0 18rpx;
  background: #efe2dd;
}

.section-block {
  margin-top: 48rpx;
}

.category-grid {
  display: flex;
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex: 1;
  align-items: flex-start;
  flex-direction: column;
  min-height: 174rpx;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
}

.category-icon {
  color: rgba(113, 74, 73, 0.68);
  font-family: Georgia, serif;
  font-size: 42rpx;
}

.category-name {
  margin-top: 14rpx;
  color: #634b49;
  font-size: 30rpx;
  font-weight: 700;
}

.category-subtitle {
  margin-top: 4rpx;
  color: rgba(99, 75, 73, 0.66);
  font-size: 20rpx;
}

.service-list {
  display: flex;
  gap: 20rpx;
  overflow-x: auto;
}

.service-list service-card {
  flex: 0 0 500rpx;
}

.loading-row {
  display: flex;
  gap: 20rpx;
  overflow: hidden;
}

.loading-card {
  flex: 0 0 500rpx;
  height: 510rpx;
}

.works-section {
  margin-right: -32rpx;
}

.work-scroll {
  width: 100%;
  white-space: nowrap;
}

.work-scroll-inner {
  display: flex;
  gap: 20rpx;
  padding-right: 32rpx;
}

.work-scroll-inner work-card {
  display: inline-block;
  flex: 0 0 330rpx;
  width: 330rpx;
  white-space: normal;
}

.notice-card {
  position: relative;
  margin-top: 52rpx;
  padding: 38rpx 32rpx 34rpx;
  border-radius: 26rpx;
  background: #f6e9e5;
}

.notice-mark {
  position: absolute;
  top: 12rpx;
  left: 26rpx;
  color: #cd9a99;
  font-family: Georgia, serif;
  font-size: 64rpx;
  line-height: 1;
}

.notice-copy {
  display: block;
  color: #765c58;
  font-size: 25rpx;
  line-height: 1.7;
}

.notice-sign {
  display: block;
  margin-top: 16rpx;
  color: #b48180;
  font-family: Georgia, serif;
  font-size: 22rpx;
  text-align: right;
}
