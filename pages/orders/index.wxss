.orders-page {
  padding-top: 26rpx;
}

.orders-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 10rpx 4rpx 18rpx;
}

.page-title {
  display: block;
  margin-top: 12rpx;
  color: #332c2b;
  font-family: inherit;
  font-size: 44rpx;
  font-weight: 700;
}

.orders-count {
  padding-bottom: 6rpx;
  color: #a08c86;
  font-size: 22rpx;
}

.status-tabs {
  width: 100%;
  margin: 4rpx 0 28rpx;
  white-space: nowrap;
}

.status-tabs-inner {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 24rpx 8rpx 0;
}

.status-tab {
  min-width: 112rpx;
  padding: 15rpx 22rpx;
  border-radius: 999rpx;
  background: #f8efec;
  color: #9a8581;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: center;
}

.status-tab.active {
  background: #bb6f79;
  color: #ffffff;
  font-weight: 600;
}

.order-loading {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-skeleton {
  height: 270rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.load-more-button { margin: 28rpx auto 0; border: 1rpx solid #ead7d2; border-radius: 999rpx; background: #fffaf7; color: #9f6e70; font-size: 24rpx; }

.order-card {
  display: flex;
  gap: 20rpx;
  min-height: 270rpx;
  padding: 18rpx;
}

.order-visual {
  flex: 0 0 176rpx;
  width: 176rpx;
  height: 234rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f0e1dd;
}

.order-visual image,
.order-visual-fallback {
  display: block;
  width: 100%;
  height: 100%;
}

.order-visual-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #aa777b;
  font-size: 25rpx;
}

.order-content {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  padding: 4rpx 2rpx 0 0;
}

.order-card-top,
.order-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-card-top {
  align-items: flex-start;
  gap: 14rpx;
}

.order-card-title {
  min-width: 0;
}

.order-service,
.order-style {
  display: block;
}

.order-service {
  overflow: hidden;
  color: #594846;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-style {
  margin-top: 8rpx;
  overflow: hidden;
  color: #9a8581;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-appointment {
  display: block;
  margin-top: 24rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #fff5f2;
}

.info-label,
.order-amount-label {
  color: #a08c86;
  font-size: 21rpx;
}

.order-date {
  display: block;
  margin-top: 6rpx;
  color: #765c58;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
  white-space: nowrap;
}

.payment-countdown {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #efd9d3;
  color: #a97868;
}

.countdown-indicator {
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #d49a72;
  box-shadow: 0 0 0 5rpx rgba(212, 154, 114, 0.12);
}

.countdown-caption,
.countdown-tip {
  flex: 0 0 auto;
  white-space: nowrap;
}

.countdown-caption {
  font-size: 19rpx;
}

.countdown-value {
  flex: 0 0 auto;
  margin-left: 10rpx;
  color: #b86670;
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1;
}

.countdown-tip {
  margin-left: auto;
  color: #b19d98;
  font-size: 18rpx;
}

.payment-countdown.urgent .countdown-indicator {
  background: #c86e63;
  box-shadow: 0 0 0 5rpx rgba(200, 110, 99, 0.14);
}

.payment-countdown.urgent .countdown-value {
  color: #c35f61;
}

.order-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.order-meta-item {
  min-width: 0;
}

.info-value {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #765c58;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-card-bottom {
  margin-top: auto;
  padding-top: 14rpx;
  border-top: 1rpx solid #f2e9e5;
}

.order-amount {
  display: flex;
  align-items: baseline;
  flex: 1;
  gap: 8rpx;
  min-width: 0;
}

.order-amount-label,
.order-paid {
  flex: 0 0 auto;
  white-space: nowrap;
}

.order-paid {
  color: #bb6f79;
  font-size: 29rpx;
  font-weight: 600;
}

.order-detail-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 136rpx;
  min-width: 136rpx;
  max-width: 136rpx;
  height: 48rpx;
  margin: 0 0 0 12rpx;
  padding: 0;
  border: 1rpx solid #dfb0b4;
  border-radius: 12rpx;
  background: #fff8f7;
  color: #a85d68;
  font-size: 21rpx;
  line-height: 1;
  white-space: nowrap;
  box-shadow: 0 6rpx 14rpx rgba(187, 111, 121, 0.08);
}

.order-detail-button:active {
  background: #f8e9e7;
  transform: scale(0.98);
}

@media (max-width: 380px) {
  .order-card { gap: 16rpx; }
  .order-visual { flex-basis: 150rpx; width: 150rpx; height: 218rpx; }
  .order-appointment { margin-top: 18rpx; padding: 12rpx; }
  .order-date { font-size: 24rpx; }
  .order-detail-button { width: 124rpx; min-width: 124rpx; max-width: 124rpx; height: 46rpx; font-size: 20rpx; }
}
