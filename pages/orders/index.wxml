<view class="page-shell orders-page">
  <view class="orders-heading"><text class="page-title">预约记录</text></view>
  <scroll-view class="status-tabs" scroll-x="true" show-scrollbar="false">
    <view class="status-tabs-inner"><view wx:for="{{tabs}}" wx:key="id" class="status-tab {{activeStatus === item.id ? 'active' : ''}}" data-status="{{item.id}}" bindtap="selectTab">{{item.label}}</view></view>
  </scroll-view>
  <view wx:if="{{loading}}" class="order-loading"><view wx:for="{{skeletons}}" wx:key="*this" class="skeleton order-skeleton"></view></view>
  <view wx:elif="{{orders.length}}" class="order-list">
    <view wx:for="{{orders}}" wx:key="id" class="order-card card" data-id="{{item.id}}" bindtap="openOrder">
      <view class="order-visual"><image wx:if="{{item.work && item.work.imageUrl}}" src="{{item.work.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" webp="{{true}}"/><view wx:else class="order-visual-fallback">预约</view></view>
      <view class="order-content"><view class="order-card-top"><view class="order-card-title"><text class="order-service">{{item.serviceName}}</text><text class="order-style" wx:if="{{item.work}}">{{item.work.title}}</text></view><status-badge status="{{item.status}}" label="{{item.statusLabel}}"></status-badge></view>
      <view class="order-time"><text class="time-icon">◷</text><text class="order-date">{{item.timeLabel}}</text><text class="order-duration">服务 {{item.durationText}}</text></view>
      <text class="order-tech">{{item.technicianName}} 服务</text>
      <view class="order-card-bottom"><text class="order-id">订单 {{item.id}}</text><text class="order-paid">实付 {{item.paidText}}</text></view></view>
    </view>
  </view>
  <empty-state wx:else title="还没有预约记录" button-text="选款" bindaction="goBooking"></empty-state>
</view>
