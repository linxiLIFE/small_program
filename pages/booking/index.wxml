<view class="page-shell booking-page">
  <view wx:if="{{loading}}" class="booking-loading">
    <view class="skeleton booking-skeleton"></view><view class="skeleton booking-skeleton short"></view>
  </view>
  <view wx:elif="{{!service.id}}" class="booking-empty"><view class="booking-empty-art"><image wx:if="{{emptyImage}}" src="{{emptyImage}}" mode="aspectFill" webp="{{true}}"/><view wx:else class="booking-empty-art-fallback"><view class="booking-art-orbit orbit-one"></view><view class="booking-art-orbit orbit-two"></view><view class="booking-art-core"><text>拾</text></view><text class="booking-art-spark spark-one">✦</text><text class="booking-art-spark spark-two">·</text></view><view class="booking-empty-art-shade"></view></view><button class="primary-button" bindtap="chooseStyle">选款</button></view>
  <block wx:else>
    <view wx:if="{{work}}" class="selected-style card"><image wx:if="{{work.imageUrl && !workImageError}}" src="{{work.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" webp="{{true}}" binderror="handleWorkImageError"/><view wx:else class="selected-style-image-fallback">款式</view><view class="selected-style-copy"><text class="selected-style-title">{{work.title}}</text><text class="selected-style-meta">{{service.categoryName}} · {{service.name}}</text></view><button bindtap="chooseStyle">更换</button></view>
    <view class="booking-service card">
      <view class="booking-service-copy"><text class="booking-service-name">{{service.name}}</text><text class="booking-service-meta">{{service.durationText}} · {{service.categoryName}}</text></view>
      <text class="booking-service-price">¥{{service.priceText}}</text>
    </view>

    <view wx:if="{{showsAddonStep}}" class="booking-step addon-step">
      <view class="step-heading"><text class="step-number">01</text><text class="step-title">{{addonStepTitle}}</text></view>
      <view class="addon-panel card">
        <view wx:if="{{showsRemovalChoice}}" class="addon-group">
        <view class="addon-group-heading"><text class="addon-question-title">卸甲</text><text class="addon-badge">{{removalBadgeText}}</text></view>
        <view class="addon-options">
          <button class="addon-option {{selectedRemovalId === 'none' ? 'selected' : ''}}" data-type="removal" data-id="none" bindtap="selectAddon"><view class="addon-option-main"><text>不需要</text><text wx:if="{{selectedRemovalId === 'none'}}" class="addon-option-check">✓</text></view></button>
          <button wx:for="{{removalOptions}}" wx:key="id" class="addon-option {{selectedRemovalId === item.id ? 'selected' : ''}}" data-type="removal" data-id="{{item.id}}" bindtap="selectAddon"><view class="addon-option-main"><text>{{item.name}}</text><text wx:if="{{selectedRemovalId === item.id}}" class="addon-option-check">✓</text></view><text class="addon-option-meta">{{item.priceText}} · {{item.durationText}}</text></button>
        </view>
        </view>
        <view wx:if="{{requiresBuilderChoice}}" class="addon-group builder-group">
        <view class="addon-group-heading"><text class="addon-question-title">建构</text></view>
        <view class="addon-options">
          <button class="addon-option {{selectedBuilderId === 'none' ? 'selected' : ''}}" data-type="builder" data-id="none" bindtap="selectAddon"><view class="addon-option-main"><text>不需要</text><text wx:if="{{selectedBuilderId === 'none'}}" class="addon-option-check">✓</text></view></button>
          <button wx:for="{{builderOptions}}" wx:key="id" class="addon-option {{selectedBuilderId === item.id ? 'selected' : ''}}" data-type="builder" data-id="{{item.id}}" bindtap="selectAddon"><view class="addon-option-main"><text>{{item.name}}</text><text wx:if="{{selectedBuilderId === item.id}}" class="addon-option-check">✓</text></view><text class="addon-option-meta">{{item.priceText}} · {{item.durationText}}</text></button>
        </view>
        </view>
        <view wx:if="{{supportsFootTipAddon}}" class="addon-group foot-tip-group {{showsRemovalChoice ? '' : 'only'}}">
          <view class="addon-group-heading foot-tip-heading"><view><text class="addon-question-title">是否需要加脚甲片</text><text class="foot-tip-subtitle">可按实际需要选择数量</text></view><text class="foot-tip-price">¥5/个</text></view>
          <view class="foot-tip-choices">
            <button class="foot-tip-choice {{selectedFootTipChoice === 'none' ? 'selected' : ''}}" data-choice="none" bindtap="selectFootTipChoice"><text>不需要</text><text wx:if="{{selectedFootTipChoice === 'none'}}">✓</text></button>
            <button class="foot-tip-choice {{selectedFootTipChoice === 'add' ? 'selected' : ''}}" data-choice="add" bindtap="selectFootTipChoice"><text>需要加甲片</text><text wx:if="{{selectedFootTipChoice === 'add'}}">✓</text></button>
          </view>
          <view wx:if="{{selectedFootTipChoice === 'add'}}" class="foot-tip-counter">
            <view class="foot-tip-counter-copy"><text>加甲片数量</text><text>小计 ¥{{footTipTotalText}} · 不增加服务时长</text></view>
            <view class="quantity-stepper"><button disabled="{{selectedFootTipCount <= 1}}" data-delta="-1" bindtap="changeFootTipCount">−</button><view><text class="quantity-value">{{selectedFootTipCount}}</text><text>个</text></view><button disabled="{{selectedFootTipCount >= footTipOption.maxQuantity}}" data-delta="1" bindtap="changeFootTipCount">+</button></view>
          </view>
        </view>
      </view>
    </view>

    <view class="booking-step">
      <view class="step-heading"><text class="step-number">{{showsAddonStep ? '02' : '01'}}</text><text class="step-title">技师</text></view>
      <scroll-view class="technician-scroll" scroll-x="true" show-scrollbar="false">
        <view class="technician-scroll-inner">
          <view wx:for="{{technicians}}" wx:key="id" class="booking-tech {{selectedTechnicianId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectTechnician">
            <image wx:if="{{item.avatarUrl}}" class="booking-tech-avatar" mode="aspectFill" lazy-load="{{true}}" webp="{{true}}" src="{{item.avatarUrl}}" />
            <view wx:else class="booking-tech-avatar avatar-fallback">{{item.initial}}</view>
            <text class="booking-tech-name">{{item.name}}</text><text class="booking-tech-title">{{item.title}}</text>
            <view wx:if="{{selectedTechnicianId === item.id}}" class="tech-check">✓</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="booking-step">
      <view class="step-heading"><text class="step-number">{{showsAddonStep ? '03' : '02'}}</text><text class="step-title">日期</text></view>
      <scroll-view class="date-scroll" scroll-x="true" show-scrollbar="false">
        <view class="date-scroll-inner">
          <view wx:for="{{dates}}" wx:key="value" class="date-item {{selectedDate === item.value ? 'selected' : ''}}" data-date="{{item.value}}" bindtap="selectDate"><text>{{item.label}}</text></view>
        </view>
      </scroll-view>
    </view>

    <view class="booking-step slot-step">
      <view class="step-heading"><text class="step-number">{{showsAddonStep ? '04' : '03'}}</text><text class="step-title">时间</text></view>
      <view wx:if="{{showsAddonStep && !addonsReady}}" class="timeline-no-options card">{{addonIncompleteText}}</view>
      <view wx:elif="{{timeline.segments.length && timelineHasOptions}}" class="timeline-card card" data-time-periods="{{timePeriods.length}}">
        <view class="timeline-heading"><text class="timeline-date">{{selectedDate}}</text><text class="timeline-duration">{{service.durationText}}</text></view>
        <view class="timeline-stage">
          <view class="timeline-ticks"><text wx:for="{{timeline.ticks}}" wx:key="label" style="{{item.leftStyle}}">{{item.label}}</text></view>
          <view class="timeline-area">
            <view id="timeline-track" class="timeline-track">
              <view wx:for="{{timeline.segments}}" wx:key="id" class="timeline-segment {{item.kind}}" style="{{item.leftStyle}}{{item.widthStyle}}"></view>
              <view wx:if="{{timelineSelectionStyle}}" class="timeline-selection {{selectedSlotId && !timelineDragging ? 'confirmed' : 'preview'}}" style="{{timelineSelectionStyle}}"></view>
            </view>
            <view wx:if="{{timelineHasOptions}}" class="timeline-handle handle-start" style="left:{{timelineStartX}}px;" data-edge="start" catchtouchstart="handleTimelineTouchStart" catchtouchmove="handleTimelineTouchMove" catchtouchend="handleTimelineTouchEnd" catchtouchcancel="handleTimelineTouchCancel"><view class="timeline-handle-cap"></view></view>
            <view wx:if="{{timelineHasOptions}}" class="timeline-handle handle-end" style="left:{{timelineEndX}}px;" data-edge="end" catchtouchstart="handleTimelineTouchStart" catchtouchmove="handleTimelineTouchMove" catchtouchend="handleTimelineTouchEnd" catchtouchcancel="handleTimelineTouchCancel"><view class="timeline-handle-cap"></view></view>
          </view>
        </view>
        <view class="timeline-legend"><view><i class="legend-dot available"></i>可预约</view><view><i class="legend-dot occupied"></i>已占用</view><view><i class="legend-dot blocked"></i>休息或不可预约</view></view>
        <view wx:if="{{selectedSlot.id || timelineDragging}}" class="selected-time"><text>{{timelineDragging ? '正在选择' : '已选服务时段'}}</text><strong>{{timelineSelectionLabel || selectedSlot.rangeLabel}}</strong></view>
      </view>
      <view wx:else class="timeline-no-options card">当天没有可预约时段</view>
    </view>

    <view class="booking-step">
      <view class="step-heading"><text class="step-number">{{showsAddonStep ? '05' : '04'}}</text><text class="step-title">积分</text></view>
      <view class="points-option card">
        <view><text class="points-title">使用积分抵扣</text><text class="points-balance">可用 {{profile.points || 0}} 积分</text></view>
        <switch color="#bb6f79" checked="{{usePoints}}" bindchange="togglePoints"></switch>
      </view>
    </view>

    <view class="contact-card card">
      <view><text class="contact-label">手机号</text><text class="contact-phone">{{profile.phoneLabel || '未绑定'}}</text></view>
      <button wx:if="{{!profile.phone && !profile.phoneMasked}}" class="bind-phone-button" open-type="getPhoneNumber|agreePrivacyAuthorization" phone-number-no-quota-toast="false" bindgetphonenumber="handleGetPhoneNumber" bindagreeprivacyauthorization="handleAgreePrivacyAuthorization">授权手机号</button>
      <text wx:else class="bound-mark">已绑定 ✓</text>
    </view>

    <view class="booking-policy-card card">
      <view class="policy-mark">!</view>
      <view><text class="policy-title">预约与退款规则</text><text>{{refundRuleText}}</text><text>{{noShowRuleText}}</text><text>非人为原因7天内免费修补</text><text>消费1元可累积1积分，20积分可抵扣1元</text></view>
    </view>

    <view class="booking-summary card">
      <view wx:for="{{selectedAddons}}" wx:key="id" class="summary-row addon-summary-row"><text>{{item.typeLabel}} · {{item.name}}（{{item.detailText}}）</text><text>{{item.priceFen ? '¥' + item.priceText : '免费'}}</text></view>
      <view class="summary-row"><text>项目金额</text><text>{{quote.quoteId ? quote.totalText : '--'}}</text></view>
      <view class="summary-row discount-row"><text>积分抵扣（{{quote.quoteId ? quote.pointsToUse : 0}} 分）</text><text>{{quote.quoteId ? '- ' + quote.discountText : '--'}}</text></view>
      <view class="divider"></view>
      <view class="summary-total"><text>微信支付</text><text>{{quote.quoteId ? quote.paidText : '--'}}</text></view>
      <button class="primary-button" loading="{{submitting}}" disabled="{{!canSubmit || submitting}}" bindtap="submitBooking">锁定时段并支付</button>

    </view>
  </block>
</view>
