.booking-page {
  padding-top: 26rpx;
  padding-bottom: 50rpx;
  overflow-x: hidden;
}

.booking-loading {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.booking-skeleton {
  height: 160rpx;
}

.booking-skeleton.short {
  height: 420rpx;
}

.booking-heading {
  padding: 10rpx 4rpx 24rpx;
}

.page-title {
  display: block;
  margin-top: 12rpx;
  color: #332c2b;
  font-family: inherit;
  font-size: 44rpx;
  font-weight: 700;
}

.booking-service {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.booking-service-copy {
  min-width: 0;
}

.booking-service-label,
.booking-service-name,
.booking-service-meta {
  display: block;
}

.booking-service-label,
.selected-style-label {
  color: #b47b7e;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.booking-service-name {
  margin-top: 5rpx;
  color: #594846;
  font-size: 30rpx;
  font-weight: 700;
}

.booking-service-meta {
  margin-top: 8rpx;
  color: #a08c86;
  font-size: 22rpx;
}

.booking-service-price {
  color: #bb6f79;
  font-family: inherit;
  font-size: 34rpx;
  font-weight: 700;
}

.booking-step {
  margin-top: 42rpx;
}

.step-heading {
  display: flex;
  align-items: flex-start;
}

.step-number {
  margin-right: 16rpx;
  color: #c99a97;
  font-family: inherit;
  font-size: 28rpx;
  font-weight: 700;
}

.step-title,
.step-subtitle {
  display: block;
}

.step-title {
  color: #594846;
  font-size: 32rpx;
  font-weight: 700;
}

.step-subtitle {
  margin-top: 6rpx;
  color: #a08c86;
  font-size: 21rpx;
}

.technician-scroll,
.date-scroll {
  width: 100%;
  max-width: 100%;
  white-space: nowrap;
}

.technician-scroll {
  margin-top: 22rpx;
}

.technician-scroll-inner,
.date-scroll-inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0 14rpx;
}

.booking-tech {
  position: relative;
  display: flex;
  align-items: center;
  flex: 0 0 290rpx;
  min-height: 104rpx;
  padding: 16rpx;
  border: 1rpx solid #eee1dc;
  border-radius: 20rpx;
  background: #fffdfb;
}

.booking-tech.selected {
  border-color: #cd9296;
  background: #fff5f4;
}

.booking-tech-avatar {
  flex: 0 0 66rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efd9d5;
  color: #a66b70;
  font-size: 28rpx;
}

.booking-tech-name,
.booking-tech-title {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.booking-tech-name {
  margin-left: 14rpx;
  color: #594846;
  font-size: 27rpx;
  font-weight: 700;
}

.booking-tech-title {
  position: absolute;
  bottom: 14rpx;
  left: 96rpx;
  max-width: 170rpx;
  color: #a08c86;
  font-size: 20rpx;
}

.tech-check {
  position: absolute;
  right: 12rpx;
  top: 10rpx;
  color: #bb6f79;
  font-size: 23rpx;
}

.date-scroll {
  margin-top: 24rpx;
}

.date-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 138rpx;
  height: 68rpx;
  padding: 0 20rpx;
  border: 1rpx solid #eee1dc;
  border-radius: 17rpx;
  background: #fffdfb;
  color: #957f7a;
  font-size: 23rpx;
}

.date-item.selected {
  border-color: #bb6f79;
  background: #bb6f79;
  color: #ffffff;
}

.slot-step {
  margin-top: 36rpx;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.slot-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  border: 1rpx solid #eee1dc;
  border-radius: 16rpx;
  background: #fffdfb;
  color: #765c58;
  font-size: 24rpx;
}

.slot-item.selected {
  border-color: #bb6f79;
  background: #bb6f79;
  color: #ffffff;
}

.slot-item.disabled {
  background: #f5efed;
  color: #c7b9b5;
}

.points-option,
.contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 24rpx;
}

.points-title,
.points-balance,
.contact-label,
.contact-phone {
  display: block;
}

.points-title,
.contact-label {
  color: #594846;
  font-size: 27rpx;
  font-weight: 600;
}

.points-balance,
.contact-phone {
  max-width: 500rpx;
  margin-top: 8rpx;
  color: #a08c86;
  font-size: 21rpx;
  line-height: 1.4;
}

.bind-phone-button {
  height: 62rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #bb6f79;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 62rpx;
}

.bound-mark {
  color: #6c9877;
  font-size: 23rpx;
}

.booking-summary {
  margin-top: 34rpx;
  padding: 28rpx 24rpx 24rpx;
}

.summary-row,
.summary-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #806d68;
  font-size: 24rpx;
}

.discount-row {
  margin-top: 14rpx;
  color: #bb6f79;
}

.summary-total {
  margin: 20rpx 0 24rpx;
  color: #594846;
  font-size: 28rpx;
  font-weight: 600;
}

.summary-total text:last-child {
  color: #bb6f79;
  font-family: inherit;
  font-size: 42rpx;
  font-weight: 700;
}

.summary-footnote {
  display: block;
  margin-top: 16rpx;
  color: #b19d98;
  font-size: 21rpx;
  text-align: center;
}

.selected-style{display:flex;align-items:center;gap:20rpx;padding:20rpx;margin:24rpx 0}.selected-style image{flex-shrink:0;width:126rpx;height:150rpx;border-radius:16rpx;background:#f1e2dd}.selected-style-copy{flex:1;min-width:0}.selected-style-title,.selected-style-meta{display:block}.selected-style-title{margin-top:8rpx;overflow:hidden;color:#594846;font-size:29rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.selected-style-meta{margin-top:8rpx;overflow:hidden;color:#9a8581;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.selected-style button{flex:0 0 100rpx;width:100rpx;height:60rpx;line-height:60rpx;margin:0;padding:0;border-radius:14rpx;font-size:23rpx;background:#f4e8e4;color:#895b61}.booking-empty{display:flex;align-items:center;flex-direction:column;padding:100rpx 24rpx 0;text-align:center}.booking-empty-art{position:relative;width:100%;height:430rpx;overflow:hidden;border-radius:30rpx;background:#f0dfda;box-shadow:0 18rpx 36rpx rgba(104,69,63,.08)}.booking-empty-art image{width:100%;height:100%;display:block}.booking-empty-art-fallback{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14rpx;width:100%;height:100%;background:linear-gradient(145deg,#ecd0cb,#f6e9df 55%,#d9bdc0);color:#a86f75}.booking-empty-art-fallback text:first-child{font-size:76rpx}.booking-empty-art-fallback text:last-child{font-size:28rpx}.booking-empty-art-shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(55,35,36,.28),transparent 68%)}.booking-empty-title{margin-top:34rpx;color:#594846;font-size:36rpx;font-weight:700}.booking-empty .primary-button{width:100%;margin-top:24rpx}

.time-period-list {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.time-period {
  position: relative;
  padding: 24rpx;
  border: 1rpx solid #eee1dc;
  border-radius: 22rpx;
  background: #fffdfb;
}

.time-period.selected,
.time-period.expanded {
  border-color: #bb6f79;
  background: #fff7f5;
}

.time-period-main,
.time-period-side {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.time-period-label {
  color: #594846;
  font-size: 29rpx;
  font-weight: 700;
}

.time-period-range {
  color: #a06f75;
  font-size: 29rpx;
  font-weight: 600;
}

.time-period-side {
  margin-top: 12rpx;
  color: #a08c86;
  font-size: 21rpx;
}

.time-period-arrow {
  color: #bb6f79;
}

.time-period-options {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0e4df;
}

.time-options-title {
  display: block;
  margin-bottom: 14rpx;
  color: #806d68;
  font-size: 22rpx;
  font-weight: 600;
}

.time-period-options .slot-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 0;
}

.time-period-options .slot-item {
  min-height: 68rpx;
  height: auto;
  padding: 12rpx 8rpx;
  line-height: 1.3;
  text-align: center;
}

.selected-time {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f8eee9;
  color: #987a73;
  font-size: 21rpx;
}

.selected-time strong {
  color: #9f626b;
  font-size: 25rpx;
}
