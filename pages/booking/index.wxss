.booking-page {
  padding-top: 26rpx;
  padding-bottom: 50rpx;
  overflow-x: hidden;
}

.booking-loading {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.booking-skeleton {
  height: 160rpx;
}

.booking-skeleton.short {
  height: 420rpx;
}

.booking-heading {
  padding: 10rpx 4rpx 24rpx;
}

.page-title {
  display: block;
  margin-top: 12rpx;
  color: #332c2b;
  font-family: inherit;
  font-size: 44rpx;
  font-weight: 700;
}

.booking-service {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.booking-service-copy {
  min-width: 0;
}

.booking-service-label,
.booking-service-name,
.booking-service-meta {
  display: block;
}

.booking-service-label,
.selected-style-label {
  color: #b47b7e;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.booking-service-name {
  margin-top: 5rpx;
  color: #594846;
  font-size: 30rpx;
  font-weight: 700;
}

.booking-service-meta {
  margin-top: 8rpx;
  color: #a08c86;
  font-size: 22rpx;
}

.booking-service-price {
  color: #bb6f79;
  font-family: inherit;
  font-size: 34rpx;
  font-weight: 700;
}

.booking-step {
  margin-top: 42rpx;
}

.step-heading {
  display: flex;
  align-items: flex-start;
}

.step-number {
  margin-right: 16rpx;
  color: #c99a97;
  font-family: inherit;
  font-size: 28rpx;
  font-weight: 700;
}

.step-title {
  display: block;
}

.step-title {
  color: #594846;
  font-size: 32rpx;
  font-weight: 700;
}

.technician-scroll,
.date-scroll {
  width: 100%;
  max-width: 100%;
  white-space: nowrap;
}

.technician-scroll {
  margin-top: 22rpx;
}

.technician-scroll-inner,
.date-scroll-inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0 14rpx;
}

.booking-tech {
  position: relative;
  display: flex;
  align-items: center;
  flex: 0 0 290rpx;
  min-height: 104rpx;
  padding: 16rpx;
  border: 1rpx solid #eee1dc;
  border-radius: 20rpx;
  background: #fffdfb;
}

.booking-tech.selected {
  border-color: #cd9296;
  background: #fff5f4;
}

.booking-tech-avatar {
  flex: 0 0 66rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efd9d5;
  color: #a66b70;
  font-size: 28rpx;
}

.booking-tech-name,
.booking-tech-title {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.booking-tech-name {
  margin-left: 14rpx;
  color: #594846;
  font-size: 27rpx;
  font-weight: 700;
}

.booking-tech-title {
  position: absolute;
  bottom: 14rpx;
  left: 96rpx;
  max-width: 170rpx;
  color: #a08c86;
  font-size: 20rpx;
}

.tech-check {
  position: absolute;
  right: 12rpx;
  top: 10rpx;
  color: #bb6f79;
  font-size: 23rpx;
}

.date-scroll {
  margin-top: 24rpx;
}

.date-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 138rpx;
  height: 68rpx;
  padding: 0 20rpx;
  border: 1rpx solid #eee1dc;
  border-radius: 17rpx;
  background: #fffdfb;
  color: #957f7a;
  font-size: 23rpx;
}

.date-item.selected {
  border-color: #bb6f79;
  background: #bb6f79;
  color: #ffffff;
}

.slot-step {
  margin-top: 36rpx;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.slot-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  border: 1rpx solid #eee1dc;
  border-radius: 16rpx;
  background: #fffdfb;
  color: #765c58;
  font-size: 24rpx;
}

.slot-item.selected {
  border-color: #bb6f79;
  background: #bb6f79;
  color: #ffffff;
}

.slot-item.disabled {
  background: #f5efed;
  color: #c7b9b5;
}

.points-option,
.contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 24rpx;
}

.booking-policy-card { display:flex; gap:20rpx; margin:24rpx 0; padding:28rpx; background:linear-gradient(135deg,#fff8ef,#f9ece8); border:1rpx solid rgba(184,120,116,.16); }
.policy-mark { width:42rpx; height:42rpx; flex:0 0 42rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#b8767b; color:#fff; font-weight:700; }
.booking-policy-card > view:last-child { display:flex; flex-direction:column; gap:10rpx; }
.booking-policy-card text { color:#8b6c67; font-size:23rpx; line-height:1.65; }
.booking-policy-card .policy-title { color:#5f4745; font-size:27rpx; font-weight:600; }

.points-title,
.points-balance,
.contact-label,
.contact-phone {
  display: block;
}

.points-title,
.contact-label {
  color: #594846;
  font-size: 27rpx;
  font-weight: 600;
}

.points-balance,
.contact-phone {
  max-width: 500rpx;
  margin-top: 8rpx;
  color: #a08c86;
  font-size: 21rpx;
  line-height: 1.4;
}

.bind-phone-button {
  height: 62rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #bb6f79;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 62rpx;
}

.bound-mark {
  color: #6c9877;
  font-size: 23rpx;
}

.booking-summary {
  margin-top: 34rpx;
  padding: 28rpx 24rpx 24rpx;
}

.summary-row,
.summary-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #806d68;
  font-size: 24rpx;
}

.discount-row {
  margin-top: 14rpx;
  color: #bb6f79;
}

.summary-total {
  margin: 20rpx 0 24rpx;
  color: #594846;
  font-size: 28rpx;
  font-weight: 600;
}

.summary-total text:last-child {
  color: #bb6f79;
  font-family: inherit;
  font-size: 42rpx;
  font-weight: 700;
}

.summary-footnote {
  display: block;
  margin-top: 16rpx;
  color: #b19d98;
  font-size: 21rpx;
  text-align: center;
}

.selected-style{display:flex;align-items:center;gap:20rpx;padding:20rpx;margin:24rpx 0}.selected-style image,.selected-style-image-fallback{flex-shrink:0;width:126rpx;height:150rpx;border-radius:16rpx;background:#f1e2dd}.selected-style-image-fallback{display:flex;align-items:center;justify-content:center;color:#a77e7f;font-size:22rpx}.selected-style-copy{flex:1;min-width:0}.selected-style-title,.selected-style-meta{display:block}.selected-style-title{margin-top:8rpx;overflow:hidden;color:#594846;font-size:29rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.selected-style-meta{margin-top:8rpx;overflow:hidden;color:#9a8581;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.selected-style button{flex:0 0 100rpx;width:100rpx;height:60rpx;line-height:60rpx;margin:0;padding:0;border-radius:14rpx;font-size:23rpx;background:#f4e8e4;color:#895b61}.booking-empty{display:flex;align-items:center;flex-direction:column;padding:100rpx 24rpx 0;text-align:center}.booking-empty-art{position:relative;width:100%;height:430rpx;overflow:hidden;border-radius:30rpx;background:#f0dfda;box-shadow:0 18rpx 36rpx rgba(104,69,63,.08)}.booking-empty-art image{width:100%;height:100%;display:block}.booking-empty-art-fallback{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14rpx;width:100%;height:100%;background:linear-gradient(145deg,#ecd0cb,#f6e9df 55%,#d9bdc0);color:#a86f75}.booking-empty-art-fallback text:first-child{font-size:76rpx}.booking-empty-art-fallback text:last-child{font-size:28rpx}.booking-empty-art-shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(55,35,36,.28),transparent 68%)}.booking-empty-title{margin-top:34rpx;color:#594846;font-size:36rpx;font-weight:700}.booking-empty .primary-button{width:100%;margin-top:24rpx}

.time-period-list {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.time-period {
  position: relative;
  padding: 24rpx;
  border: 1rpx solid #eee1dc;
  border-radius: 22rpx;
  background: #fffdfb;
}

.time-period.selected,
.time-period.expanded {
  border-color: #bb6f79;
  background: #fff7f5;
}

.time-period-main,
.time-period-side {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.time-period-label {
  color: #594846;
  font-size: 29rpx;
  font-weight: 700;
}

.time-period-range {
  color: #a06f75;
  font-size: 29rpx;
  font-weight: 600;
}

.time-period-side {
  margin-top: 12rpx;
  color: #a08c86;
  font-size: 21rpx;
}

.time-period-arrow {
  color: #bb6f79;
}

.time-period-options {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0e4df;
}

.time-options-title {
  display: block;
  margin-bottom: 14rpx;
  color: #806d68;
  font-size: 22rpx;
  font-weight: 600;
}

.time-period-options .slot-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 0;
}

.time-period-options .slot-item {
  min-height: 68rpx;
  height: auto;
  padding: 12rpx 8rpx;
  line-height: 1.3;
  text-align: center;
}

.selected-time {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f8eee9;
  color: #987a73;
  font-size: 21rpx;
}

.selected-time strong {
  color: #9f626b;
  font-size: 25rpx;
}

.booking-empty-art-fallback {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: radial-gradient(circle at 35% 28%, #f9eee3 0, #f5e3dc 30%, transparent 31%), linear-gradient(145deg, #ead0cb, #f6e9df 55%, #d9bdc0);
}

.booking-empty-art-fallback::before,
.booking-empty-art-fallback::after {
  position: absolute;
  border: 1rpx solid rgba(255, 250, 247, .64);
  border-radius: 50%;
  content: '';
}

.booking-empty-art-fallback::before {
  top: 56rpx;
  right: -46rpx;
  width: 310rpx;
  height: 310rpx;
}

.booking-empty-art-fallback::after {
  bottom: -122rpx;
  left: -90rpx;
  width: 420rpx;
  height: 420rpx;
  border-color: rgba(175, 113, 119, .28);
}

.booking-art-orbit {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 2rpx solid rgba(171, 105, 113, .55);
  border-radius: 50%;
  transform: translate(-50%, -50%) rotate(-24deg);
}

.orbit-one {
  width: 260rpx;
  height: 150rpx;
}

.orbit-two {
  width: 150rpx;
  height: 260rpx;
  border-color: rgba(255, 250, 247, .72);
  transform: translate(-50%, -50%) rotate(35deg);
}

.booking-art-core {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid rgba(255, 250, 247, .78);
  border-radius: 50%;
  background: rgba(255, 250, 247, .3);
  color: #a76e75;
  box-shadow: 0 10rpx 30rpx rgba(130, 81, 83, .12);
  transform: translate(-50%, -50%);
}

.booking-art-core text {
  font-family: Georgia, serif;
  font-size: 52rpx;
}

.booking-art-spark {
  position: absolute;
  color: #fffaf7;
  font-family: Georgia, serif;
}

.spark-one { top: 84rpx; left: 24%; font-size: 46rpx; }
.spark-two { right: 24%; bottom: 100rpx; font-size: 58rpx; }
.booking-empty-art-fallback text.booking-art-spark { display: block; margin: 0; font-size: inherit; }

.timeline-card {
  margin-top: 24rpx;
  padding: 24rpx 20rpx 18rpx;
  overflow: hidden;
  background: #fffdfb;
}

.timeline-heading,
.timeline-legend,
.timeline-legend view,
.timeline-no-options {
  display: flex;
  align-items: center;
}

.timeline-heading {
  justify-content: space-between;
  gap: 18rpx;
}

.timeline-date {
  display: block;
}

.timeline-date {
  color: #aa9189;
  font-size: 20rpx;
}

.timeline-duration {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f7e7e4;
  color: #a7646d;
  font-size: 21rpx;
}

.timeline-stage {
  position: relative;
  margin-top: 18rpx;
  padding-top: 42rpx;
}

.timeline-ticks {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 30rpx;
}

.timeline-ticks text {
  position: absolute;
  color: #b09b94;
  font-size: 19rpx;
  transform: translateX(-50%);
  white-space: nowrap;
}

.timeline-ticks text:first-child {
  transform: none;
}

.timeline-area {
  position: relative;
  width: 100%;
  height: 112rpx;
}

.timeline-track {
  position: absolute;
  top: 24rpx;
  right: 0;
  left: 0;
  height: 64rpx;
  overflow: hidden;
  border: 1rpx solid #eee1dc;
  border-radius: 34rpx;
  background: #faf3ef;
  box-shadow: inset 0 2rpx 8rpx rgba(106, 73, 66, .06);
}

.timeline-segment {
  position: absolute;
  top: 0;
  height: 100%;
  box-sizing: border-box;
  border-right: 1rpx solid rgba(151, 112, 106, .1);
}

.timeline-segment.available {
  background: #fff;
}

.timeline-segment.occupied {
  background: repeating-linear-gradient(135deg, #d49da3 0, #d49da3 10rpx, #c58691 10rpx, #c58691 18rpx);
}

.timeline-segment.break,
.timeline-segment.unavailable {
  background: repeating-linear-gradient(135deg, #ead9d1 0, #ead9d1 9rpx, #dfc8c0 9rpx, #dfc8c0 15rpx);
}

.timeline-segment.closed,
.timeline-segment.leave {
  background: repeating-linear-gradient(135deg, #f3eae6 0, #f3eae6 8rpx, #e8dcd7 8rpx, #e8dcd7 14rpx);
}

.timeline-selection {
  position: absolute;
  z-index: 2;
  top: -2rpx;
  height: 64rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.timeline-selection.confirmed {
  border: 3rpx solid #b96875;
  border-radius: 34rpx;
  background: rgba(255, 250, 248, .26);
  box-shadow: 0 0 0 5rpx rgba(185, 104, 117, .1), 0 7rpx 16rpx rgba(172, 95, 106, .18);
}

.timeline-selection.preview {
  border: 2rpx dashed #bd7b83;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, .5);
}

.timeline-handle {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 4;
  width: 56rpx;
  height: 112rpx;
  box-sizing: border-box;
}

.timeline-handle-cap {
  position: absolute;
  top: 14rpx;
  left: 0;
  width: 56rpx;
  height: 84rpx;
  box-sizing: border-box;
  border: 3rpx solid #b96875;
  border-radius: 30rpx;
  background: #fffaf8;
  box-shadow: 0 5rpx 14rpx rgba(133, 83, 80, .18);
}

.timeline-handle-cap::after {
  position: absolute;
  top: 26rpx;
  left: 22rpx;
  width: 6rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: #c78187;
  content: '';
}

.timeline-legend {
  flex-wrap: wrap;
  gap: 12rpx 22rpx;
  margin-top: 4rpx;
  color: #a18b84;
  font-size: 20rpx;
}

.timeline-legend view {
  gap: 7rpx;
}

.legend-dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.available { border: 1rpx solid #eaded9; background: #fff; }
.legend-dot.occupied { background: #ca9099; }
.legend-dot.blocked { background: repeating-linear-gradient(135deg, #ead9d1 0, #ead9d1 4rpx, #d6bdb5 4rpx, #d6bdb5 8rpx); }

.timeline-no-options {
  justify-content: center;
  min-height: 56rpx;
  margin-top: 14rpx;
  border-radius: 14rpx;
  background: #faf1ed;
  color: #9d7b76;
  font-size: 21rpx;
}

.timeline-no-options {
  padding: 24rpx 20rpx;
  color: #ab928b;
  text-align: center;
}

.addon-step {
  margin-top: 30rpx;
}

.addon-panel {
  width: 100%;
  max-width: 100%;
  margin-top: 18rpx;
  padding: 24rpx;
  overflow: hidden;
}

.addon-group {
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

.addon-group-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 15rpx;
}

.builder-group {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0e2de;
}

.addon-question-title {
  color: #60484a;
  font-size: 26rpx;
  font-weight: 700;
}

.addon-badge {
  padding: 3rpx 11rpx;
  border-radius: 999rpx;
  background: #edf5ed;
  color: #68806a;
  font-size: 18rpx;
}

.addon-options {
  display: grid;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  overflow: hidden;
}

.addon-option {
  display: flex;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  min-height: 92rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  margin: 0;
  padding: 16rpx 18rpx;
  border: 2rpx solid #eee0dc;
  border-radius: 18rpx;
  background: #fff;
  color: #765b5d;
  font-size: 24rpx;
  line-height: 1.35;
  text-align: left;
  overflow: hidden;
  transition: border-color .16s ease, background .16s ease, box-shadow .16s ease;
}

.addon-option::after {
  border: 0;
}

.addon-option-main {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.addon-option-main text:first-child,
.addon-option-meta {
  min-width: 0;
  max-width: 100%;
  word-break: break-all;
  white-space: normal;
}

.addon-option-check {
  flex: 0 0 auto;
  color: #b85f6d;
  font-size: 23rpx;
  font-weight: 800;
}

.addon-option-meta {
  display: block;
  margin-top: 5rpx;
  color: #ad8f88;
  font-size: 19rpx;
}

.addon-option.selected {
  border-color: #bd707a;
  background: #fff5f3;
  box-shadow: 0 8rpx 22rpx rgba(154, 91, 98, .11);
  color: #9b505c;
}

.addon-summary-row {
  color: #7d6262;
  font-size: 22rpx;
}
