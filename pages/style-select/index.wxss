.style-select-page {
  padding-top: 26rpx;
  padding-bottom: 50rpx;
}

.page-heading {
  padding: 10rpx 4rpx 24rpx;
}

.page-title {
  display: block;
  color: #332c2b;
  font-family: inherit;
  font-size: 44rpx;
  font-weight: 700;
}

.style-select-skeleton {
  height: 420rpx;
}

.style-service {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
}

.style-service-copy {
  min-width: 0;
}

.style-service-category,
.style-service-name {
  display: block;
}

.style-service-category {
  color: #b47b7e;
  font-size: 21rpx;
}

.style-service-name {
  margin-top: 8rpx;
  overflow: hidden;
  color: #594846;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.style-service-meta {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
  color: #9a8581;
  font-size: 22rpx;
}

.style-service-meta text:first-child {
  color: #bb6f79;
  font-family: inherit;
  font-size: 34rpx;
  font-weight: 700;
}

.style-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 42rpx 0 22rpx;
}

.section-title {
  color: #594846;
  font-size: 35rpx;
  font-weight: 700;
}

.style-count {
  color: #a48c86;
  font-size: 22rpx;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28rpx 18rpx;
}

@media (max-width: 500px) {
  .style-service {
    padding: 22rpx 20rpx;
  }

  .style-service-name {
    font-size: 27rpx;
  }

  .style-service-meta text:first-child {
    font-size: 30rpx;
  }
}
