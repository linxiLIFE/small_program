<view class="page-shell services-page">
  <view class="page-heading"><text class="page-title">选款预约</text></view>
  <view wx:if="{{loading}}" class="skeleton service-skeleton"></view>
  <empty-state wx:elif="{{error}}" title="{{error}}" button-text="重试" bindaction="loadServices"/>
  <block wx:else>
    <view class="selection-section category-selection"><view class="selection-heading"><text class="section-title">选择大项</text><text class="selection-count">{{categories.length}} 个大项</text></view>
      <view class="category-choice-grid"><view wx:for="{{categories}}" wx:key="id" class="category-choice {{activeCategoryId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="handleCategoryTap" style="background: {{item.color}}"><view class="category-choice-icon">{{item.icon}}</view><view class="category-choice-copy"><text class="category-choice-name">{{item.name}}</text><text class="category-choice-meta">{{item.serviceCountText}}</text><text class="category-choice-meta">{{item.styleCountText}}</text></view><text class="choice-check">{{activeCategoryId === item.id ? '✓' : '›'}}</text></view></view>
    </view>

    <view wx:if="{{activeCategoryId}}" class="selection-section project-selection"><view class="selection-heading"><text class="section-title">选择小项目</text><text class="selection-count">{{filteredServices.length}} 个项目</text></view>
      <view wx:if="{{activeCategoryId === 'nail'}}" class="nail-removal-notice">
        <view class="nail-removal-orb"><text>✦</text></view>
        <view class="nail-removal-copy">
          <view class="nail-removal-title-row"><text class="nail-removal-title">温馨提醒</text></view>
          <text class="nail-removal-main">美甲金额超过 <text class="nail-removal-highlight">¥40</text>，卸甲服务费全免</text>
          <text class="nail-removal-subtitle">¥40 及以下项目按所选卸甲方式计费，费用以预约页展示为准</text>
        </view>
      </view>
      <view wx:if="{{filteredServices.length}}" class="project-list"><service-card wx:for="{{filteredServices}}" wx:key="id" service="{{item}}" compact="{{true}}" selected="{{activeServiceId === item.id}}" bindselect="handleProjectTap"/></view>
      <empty-state wx:else title="该大项暂未设置小项目"/>
    </view>
  </block>
</view>
