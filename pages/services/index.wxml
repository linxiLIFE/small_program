<view class="page-shell services-page">
  <view class="page-heading"><text class="page-title">选款</text></view>
  <scroll-view class="category-tabs" scroll-x show-scrollbar="{{false}}"><view class="category-tabs-inner"><view wx:for="{{categories}}" wx:key="id" class="category-tab {{activeCategoryId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="handleCategoryTap">{{item.name}}</view></view></scroll-view>
  <scroll-view class="project-tabs" scroll-x show-scrollbar="{{false}}"><view class="category-tabs-inner"><view class="project-tab {{!activeServiceId ? 'selected' : ''}}" data-id="" bindtap="handleProjectTap">全部</view><view wx:for="{{filteredServices}}" wx:key="id" class="project-tab {{activeServiceId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="handleProjectTap">{{item.name}}</view></view></scroll-view>
  <view wx:if="{{loading}}" class="skeleton service-skeleton"></view>
  <empty-state wx:elif="{{error}}" title="{{error}}" button-text="重试" bindaction="loadServices"/>
  <view wx:elif="{{visibleWorks.length}}" class="works-grid"><work-card wx:for="{{visibleWorks}}" wx:key="id" work="{{item}}" bindselect="handleWorkTap"/></view>
  <empty-state wx:else title="暂无款式"/>
</view>
