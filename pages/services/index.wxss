.services-page {
  padding-top: 26rpx;
}

.page-heading {
  padding: 10rpx 4rpx 20rpx;
}

.page-title,
.page-subtitle {
  display: block;
}

.page-title {
  margin-top: 12rpx;
  color: #332c2b;
  font-family: Georgia, "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #9a8581;
  font-size: 23rpx;
}

.category-tabs {
  width: calc(100% + 64rpx);
  margin: 12rpx -32rpx 30rpx;
  white-space: nowrap;
}

.category-tabs-inner {
  display: inline-flex;
  gap: 14rpx;
  padding: 10rpx 32rpx;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  padding: 0 28rpx;
  border: 1rpx solid #edddd8;
  border-radius: 999rpx;
  background: #fffdfb;
  color: #957f7a;
  font-size: 25rpx;
}

.category-tab.active {
  border-color: #bb6f79;
  background: #bb6f79;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(187, 111, 121, 0.18);
}

.service-page-list {
  display: flex;
  flex-direction: column;
}

.service-loading {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.service-skeleton {
  height: 220rpx;
}

.works-intro {
  margin-top: 54rpx;
  padding: 30rpx 28rpx;
  border-radius: 26rpx;
  background: #f6e9e5;
}

.works-title,
.works-subtitle {
  display: block;
}

.works-title {
  margin-top: 8rpx;
  color: #684f4b;
  font-family: Georgia, "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 700;
}

.works-subtitle {
  margin-top: 10rpx;
  color: #957b76;
  font-size: 23rpx;
  line-height: 1.55;
}

.works-grid {
  min-height: 20rpx;
}

.works-tip {
  margin: 18rpx 0 20rpx;
  color: #b19d98;
  font-size: 22rpx;
  text-align: center;
}
